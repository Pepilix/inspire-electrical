# Public URL the site is built for (no trailing slash)
SITE_URL=https://inspire-electrical.com
# Sub-path when hosted below a domain root, e.g. /inspire-electrical/ on GitHub Pages
BASE_PATH=/
# true only for the live build: removes noindex, emits sitemap, hides unverified placeholders
PRODUCTION=false
# Form handler URL (e.g. a Formspree or Basin endpoint). Forms stay disabled until set.
PUBLIC_FORM_ENDPOINT=
# Google Tag Manager container ID (GTM-XXXXXXX). Loaded only after analytics consent.
PUBLIC_GTM_ID=
