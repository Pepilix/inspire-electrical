---
// Credentials and trust. Only verified details from src/data/company.ts are published;
// on preview builds, missing items appear as "to verify" markers so gaps are obvious.
import { getCollection } from 'astro:content';
import Verify from './Verify.astro';
import { company } from '../data/company';
import { showPlaceholders } from '../lib/site';

const testimonials = await getCollection('testimonials');
const rows = [
  { label: 'Competent person scheme', value: company.competentPersonScheme && `${company.competentPersonScheme.name}${company.competentPersonScheme.id ? `, no. ${company.competentPersonScheme.id}` : ''}`, verify: 'Scheme name and registration number' },
  { label: 'Insurance', value: company.insurance && [company.insurance.publicLiability && `Public liability ${company.insurance.publicLiability}`, company.insurance.professionalIndemnity && `Professional indemnity ${company.insurance.professionalIndemnity}`].filter(Boolean).join(' · '), verify: 'Public liability cover and insurer' },
  { label: 'Qualifications', value: company.qualifications?.join(' · '), verify: 'Electrical qualifications held' },
  { label: 'Wiring regulations', value: company.standard, verify: 'BS 7671 edition and amendment certified to' },
  { label: 'Certification', value: 'Every job receives the certificate BS 7671 requires; notifiable work is registered with building control', verify: '' },
  { label: 'Group', value: `Part of Inspire, which has designed and installed technology in homes since ${company.group.since}`, verify: '' },
];
const visible = rows.filter((r) => r.value || showPlaceholders);
---
<div class="cred">
  <dl class="cred-block">
    {visible.map((r) => (
      <div>
        <dt>{r.label}</dt>
        <dd>{r.value ? r.value : <Verify label={r.verify} />}</dd>
      </div>
    ))}
  </dl>

  <div class="cred-reviews">
    {testimonials.length > 0 ? (
      testimonials.slice(0, 2).map((t) => (
        <figure class="quote">
          <blockquote><p>{t.data.quote}</p></blockquote>
          <figcaption class="mono">{t.data.name}, {t.data.location} · {t.data.source}</figcaption>
        </figure>
      ))
    ) : showPlaceholders ? (
      <div class="quote quote--empty">
        <p class="mono">Reviews</p>
        <p>Customer reviews will appear here once Inspire Electrical has completed work and customers have agreed to be quoted. None are shown until they are real.</p>
        <Verify label="Google Business Profile and first reviews" />
      </div>
    ) : null}
    {company.reviewProfiles.length > 0 && (
      <ul role="list" class="profiles">
        {company.reviewProfiles.map((p) => <li><a href={p.url}>Read reviews on {p.name}</a></li>)}
      </ul>
    )}
  </div>
</div>

<style>
  .cred { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .cred-block { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--rule-strong); }
  .cred-block > div { padding: 18px 20px; border-bottom: 1px solid var(--rule); }
  .cred-block > div:nth-child(odd) { border-right: 1px solid var(--rule); }
  .cred-block > div:nth-last-child(-n+2) { border-bottom: 0; }
  .cred-block dt { font-family: var(--mono); font-size: .6875rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
  .cred-block dd { margin-top: 6px; font-weight: 500; }
  .quote blockquote p { font-family: var(--serif); font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.2; }
  .quote figcaption { margin-top: 14px; color: var(--ink-3); }
  .quote + .quote { margin-top: 36px; padding-top: 36px; border-top: 1px solid var(--rule); }
  .quote--empty { padding: 24px; border: 1px dashed var(--rule-strong); color: var(--ink-2); }
  .quote--empty p + p { margin-top: 10px; }
  .quote--empty :global(.verify) { margin-top: 14px; }
  .profiles { margin-top: 20px; }
  .profiles a { color: var(--copper-ink); }
  @media (max-width: 860px) {
    .cred { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .cred-block { grid-template-columns: 1fr; }
    .cred-block > div:nth-child(odd) { border-right: 0; }
    .cred-block > div:nth-last-child(2) { border-bottom: 1px solid var(--rule); }
  }
</style>
