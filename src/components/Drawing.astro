---
/**
 * Technical-drawing artwork used where no real photograph exists yet.
 * Each one is labelled "Photograph to follow" in its title block, so it is never mistaken
 * for project photography. Replace by setting `image` on the service entry.
 */
type DrawingKind = 'board' | 'rewire' | 'lighting' | 'outdoor' | 'testing' | 'fault' | 'domestic' | 'newbuild' | 'design' | 'commercial' | 'commercial-lighting' | 'maintenance';

interface Props { kind: DrawingKind; tone?: 'dark' | 'paper'; label?: boolean; class?: string }
const { kind, tone = 'dark', label = true, class: className } = Astro.props;

const titles: Record<DrawingKind, [string, string]> = {
  board: ['E-01', 'Consumer unit, front elevation'],
  rewire: ['E-02', 'Ground floor, power layout'],
  lighting: ['E-03', 'Reflected ceiling plan'],
  outdoor: ['E-04', 'Garden lighting layout'],
  testing: ['E-05', 'Schedule of test results'],
  fault: ['E-06', 'Circuit, fault location'],
  domestic: ['E-07', 'Kitchen, wall elevation'],
  newbuild: ['E-08', 'Section, first fix routes'],
  design: ['E-09', 'Single-line diagram'],
  commercial: ['E-10', 'Office floor, small power'],
  'commercial-lighting': ['E-11', 'Lighting and emergency layout'],
  maintenance: ['E-12', 'Planned inspection programme'],
};
const [ref, title] = titles[kind];
const range = (n: number) => Array.from({ length: n }, (_, i) => i);
---
<figure class:list={['drawing', `drawing--${tone}`, className]}>
  <svg viewBox="0 0 800 600" role="img" aria-label={`Illustration: ${title}. Photograph to follow.`}>
    <defs>
      <pattern id={`g-${kind}-${tone}`} width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M20 0H0V20" class="d-grid" />
      </pattern>
    </defs>
    <rect width="800" height="600" class="d-bg" />
    <rect width="800" height="600" fill={`url(#g-${kind}-${tone})`} />
    <g class="d-crop">
      <path d="M30 60V30H60M740 30H770V60M30 540V570H60M740 570H770V540" />
    </g>

    {kind === 'board' && (
      <g>
        <rect x="150" y="120" width="500" height="300" class="d-line" />
        <rect x="170" y="200" width="460" height="120" class="d-faint" />
        <line x1="170" y1="260" x2="630" y2="260" class="d-faint" />
        <rect x="185" y="215" width="70" height="90" class="d-line" />
        <rect x="205" y="240" width="30" height="40" class="d-copper" />
        <text x="220" y="340" class="d-label" text-anchor="middle">MAIN</text>
        {range(10).map((i) => (
          <g>
            <rect x={275 + i * 34} y="215" width="28" height="90" class="d-line" />
            <rect x={283 + i * 34} y={i % 3 === 0 ? 236 : 252} width="12" height="22" class="d-fill" />
            <text x={289 + i * 34} y="340" class="d-label" text-anchor="middle">{i + 1}</text>
          </g>
        ))}
        <path d="M330 120V60M350 120V60" class="d-copper" />
        <text x="365" y="80" class="d-label">TAILS</text>
        <path d="M150 450H650M150 440V460M650 440V460" class="d-dim" />
        <text x="400" y="475" class="d-label" text-anchor="middle">METAL ENCLOSURE</text>
      </g>
    )}

    {kind === 'rewire' && (
      <g>
        <path d="M120 110H680V470H120Z M120 300H380V470 M380 110V250 M380 300H680 M520 300V470" class="d-line" />
        <path d="M150 440 Q260 380 300 300 T 420 200 L 600 160 M300 300 L 500 420 L 640 420 M420 200 L 420 140" class="d-copper d-dash" />
        {[[150,440],[300,300],[420,200],[600,160],[500,420],[640,420],[420,140],[220,140],[620,260]].map(([x,y]) => (
          <g><circle cx={x} cy={y} r="9" class="d-line d-solid" /><path d={`M${x-4} ${y-12}V${y-18}M${x+4} ${y-12}V${y-18}`} class="d-line" /></g>
        ))}
        <rect x="134" y="425" width="30" height="30" class="d-fill" />
        <text x="175" y="460" class="d-label">CU</text>
        <text x="250" y="210" class="d-label">LIVING</text>
        <text x="520" y="230" class="d-label">KITCHEN</text>
        <text x="220" y="400" class="d-label">HALL</text>
      </g>
    )}

    {kind === 'lighting' && (
      <g>
        <rect x="120" y="100" width="560" height="380" class="d-line" />
        {range(4).flatMap((r) => range(6).map((c) => (
          <g>
            <circle cx={180 + c * 88} cy={160 + r * 88} r="13" class={r < 2 ? 'd-copper' : 'd-line'} />
            <circle cx={180 + c * 88} cy={160 + r * 88} r="4" class="d-fill" />
          </g>
        )))}
        <rect x="150" y="130" width="500" height="148" rx="74" class="d-dash d-faint" />
        <text x="660" y="125" class="d-label" text-anchor="end">CIRCUIT A: DIMMED</text>
        <text x="660" y="470" class="d-label" text-anchor="end">CIRCUIT B: SCENE 2</text>
        <path d="M120 300H90M90 300V520H400" class="d-copper d-dash" />
      </g>
    )}

    {kind === 'outdoor' && (
      <g>
        <path d="M80 120H720" class="d-line" />
        <rect x="80" y="70" width="640" height="50" class="d-fill d-faint" />
        <text x="400" y="100" class="d-label" text-anchor="middle">HOUSE</text>
        <rect x="160" y="140" width="320" height="110" class="d-line" />
        <text x="320" y="200" class="d-label" text-anchor="middle">TERRACE</text>
        <path d="M480 200 C 560 260, 420 360, 520 470" class="d-line" style="stroke-width:28;opacity:.18" />
        {[[500,250],[490,320],[470,390],[505,450]].map(([x,y]) => <circle cx={x} cy={y} r="6" class="d-copper d-solid" />)}
        {[[220,420],[640,330]].map(([x,y]) => (
          <g>
            <circle cx={x} cy={y} r="56" class="d-faint" />
            <circle cx={x} cy={y} r="8" class="d-copper" />
            {range(8).map((k) => <line x1={x + 14 * Math.cos(k * Math.PI / 4)} y1={y + 14 * Math.sin(k * Math.PI / 4)} x2={x + 26 * Math.cos(k * Math.PI / 4)} y2={y + 26 * Math.sin(k * Math.PI / 4)} class="d-copper" />)}
          </g>
        ))}
        <path d="M120 120V500H500M120 420H164M500 120V240" class="d-copper d-dash" />
        <text x="130" y="520" class="d-label">SWA CABLE ROUTE</text>
      </g>
    )}

    {kind === 'testing' && (
      <g>
        <rect x="110" y="110" width="580" height="340" class="d-line" />
        {['CCT', 'DESCRIPTION', 'R1+R2', 'IR', 'Zs', 'RCD', '✓'].map((h, i) => (
          <text x={[130,190,390,460,520,580,650][i]} y="140" class="d-label">{h}</text>
        ))}
        <line x1="110" y1="155" x2="690" y2="155" class="d-line" />
        {range(7).map((r) => (
          <g>
            <line x1="110" y1={195 + r * 36} x2="690" y2={195 + r * 36} class="d-faint" />
            <text x="130" y={182 + r * 36} class="d-label">{r + 1}</text>
            <rect x="190" y={170 + r * 36} width={[150, 120, 170, 110, 140, 90, 130][r]} height="8" class="d-fill d-faint" />
            {[390, 460, 520, 580].map((x) => <rect x={x} y={170 + r * 36} width="36" height="8" class="d-fill d-faint" />)}
            <path d={`M650 ${176 + r * 36}l6 6 12-14`} class="d-copper" />
          </g>
        ))}
      </g>
    )}

    {kind === 'fault' && (
      <g>
        <path d="M100 300H330M400 300H700" class="d-line" style="stroke-width:3" />
        <rect x="70" y="270" width="30" height="60" class="d-fill" />
        <path d="M700 260V340M700 300H740" class="d-line" />
        <circle cx="365" cy="300" r="40" class="d-copper d-dash" />
        <path d="M352 287l26 26M378 287l-26 26" class="d-copper" style="stroke-width:3" />
        <path d="M250 300V180H200M520 300V180H570" class="d-line" />
        <circle cx="190" cy="180" r="10" class="d-line" />
        <circle cx="580" cy="180" r="10" class="d-line" />
        <path d="M365 340V440H460" class="d-copper" />
        <text x="470" y="445" class="d-label">INSULATION BREAKDOWN</text>
        <text x="100" y="360" class="d-label">CU</text>
      </g>
    )}

    {kind === 'domestic' && (
      <g>
        <path d="M100 470H700" class="d-line" />
        <rect x="100" y="330" width="600" height="140" class="d-line" />
        {range(5).map((i) => <line x1={100 + (i + 1) * 120} y1="330" x2={100 + (i + 1) * 120} y2="470" class="d-faint" />)}
        <rect x="100" y="320" width="600" height="10" class="d-fill" />
        <rect x="100" y="110" width="600" height="110" class="d-line" />
        {range(5).map((i) => <line x1={100 + (i + 1) * 120} y1="110" x2={100 + (i + 1) * 120} y2="220" class="d-faint" />)}
        {[190, 410, 560].map((x) => (
          <g><rect x={x} y="262" width="44" height="26" class="d-copper" /><circle cx={x + 13} cy="275" r="4" class="d-line" /><circle cx={x + 31} cy="275" r="4" class="d-line" /></g>
        ))}
        <rect x="320" y="262" width="26" height="26" class="d-copper" />
        <text x="333" y="306" class="d-label" text-anchor="middle">FCU</text>
        <path d="M740 470V275M730 470H750M730 275H750" class="d-dim" />
        <text x="752" y="380" class="d-label" transform="rotate(-90 752 380)" text-anchor="middle">1050 AFF</text>
      </g>
    )}

    {kind === 'newbuild' && (
      <g>
        <path d="M120 480H680M160 480V260H640V480M140 260L400 110L660 260M160 370H640" class="d-line" />
        {[230, 400, 560].map((x) => <path d={`M${x} 480V270`} class="d-copper" />)}
        <path d="M230 370H560M230 280H560" class="d-copper d-dash" />
        {[[230,440],[400,440],[560,440],[230,340],[560,340],[400,300]].map(([x,y]) => <rect x={x - 9} y={y - 9} width="18" height="18" class="d-line d-solid" />)}
        <text x="180" y="360" class="d-label">FIRST FLOOR</text>
        <text x="180" y="470" class="d-label">GROUND FLOOR</text>
        <text x="400" y="225" class="d-label" text-anchor="middle">LOFT: LIGHTING RADIALS</text>
      </g>
    )}

    {kind === 'design' && (
      <g>
        <path d="M120 300H240" class="d-line" style="stroke-width:3" />
        <circle cx="105" cy="300" r="15" class="d-line" />
        <rect x="240" y="270" width="60" height="60" class="d-line" />
        <path d="M252 318L288 282" class="d-copper" style="stroke-width:2" />
        <path d="M300 300H360M360 140V460" class="d-copper" style="stroke-width:3" />
        {range(6).map((i) => {
          const y = 150 + i * 62;
          return (
            <g>
              <path d={`M360 ${y}H440`} class="d-line" />
              <rect x="440" y={y - 14} width="36" height="28" class="d-line" />
              <path d={`M476 ${y}H640`} class="d-line" />
              <text x="652" y={y + 5} class="d-label">{['LIGHTING GF', 'LIGHTING FF', 'SOCKETS GF', 'SOCKETS FF', 'KITCHEN', 'GARDEN'][i]}</text>
            </g>
          );
        })}
        <text x="270" y="355" class="d-label" text-anchor="middle">MAIN SWITCH</text>
        <text x="90" y="345" class="d-label">SUPPLY</text>
      </g>
    )}

    {kind === 'commercial' && (
      <g>
        <rect x="100" y="100" width="600" height="400" class="d-line" />
        <path d="M120 120H680V480H120Z" class="d-copper d-dash" />
        {range(3).flatMap((r) => range(4).map((c) => (
          <g>
            <rect x={170 + c * 130} y={160 + r * 110} width="90" height="60" class="d-faint" />
            <rect x={207 + c * 130} y={232 + r * 110} width="16" height="16" class="d-copper" />
          </g>
        )))}
        <text x="680" y="95" class="d-label" text-anchor="end">PERIMETER TRAY</text>
        <text x="120" y="520" class="d-label">FLOOR BOXES AT 2.4 M CENTRES</text>
      </g>
    )}

    {kind === 'commercial-lighting' && (
      <g>
        <rect x="100" y="100" width="600" height="400" class="d-line" />
        {range(4).flatMap((r) => range(3).map((c) => (
          <rect x={150 + c * 190} y={150 + r * 90} width="130" height="14" class="d-line d-solid" />
        )))}
        {[[130,130],[670,130],[130,470],[670,470],[400,300]].map(([x,y]) => (
          <g><circle cx={x} cy={y} r="12" class="d-copper" /><path d={`M${x-7} ${y}H${x+7}`} class="d-copper" /></g>
        ))}
        <text x="400" y="530" class="d-label" text-anchor="middle">EMERGENCY LUMINAIRES SHOWN IN COPPER</text>
      </g>
    )}

    {kind === 'maintenance' && (
      <g>
        <path d="M100 160H700" class="d-line" />
        {['Q1', 'Q2', 'Q3', 'Q4'].map((q, i) => (
          <g>
            <text x={175 + i * 150} y="145" class="d-label" text-anchor="middle">{q}</text>
            <line x1={100 + i * 150} y1="130" x2={100 + i * 150} y2="470" class="d-faint" />
          </g>
        ))}
        {['EMERGENCY LIGHTING', 'FIXED WIRING', 'RCD TESTS', 'REMEDIALS', 'RECORDS'].map((t, r) => (
          <g>
            <line x1="100" y1={210 + r * 60} x2="700" y2={210 + r * 60} class="d-faint" />
            <text x="100" y={200 + r * 60} class="d-label">{t}</text>
            {range(4).filter((q) => (r === 1 ? q === 2 : r === 3 ? q > 0 : true)).map((q) => (
              <rect x={130 + q * 150} y={186 + r * 60} width={r === 4 ? 90 : 40} height="14" class={r === 1 ? 'd-copper d-solid' : 'd-fill'} />
            ))}
          </g>
        ))}
      </g>
    )}
  </svg>
  {label && (
    <figcaption class="title-block">
      <span class="tb-ref">DWG {ref}</span>
      <span class="tb-title">{title}</span>
      <span class="tb-note">Photograph to follow</span>
    </figcaption>
  )}
</figure>

<style>
  .drawing { position: relative; margin: 0; overflow: hidden; }
  .drawing svg { width: 100%; height: 100%; object-fit: cover; }
  .drawing--dark { color: var(--on-dark); --d-bg: var(--charcoal-2); --d-grid: rgba(241, 238, 232, .05); --d-acc: var(--copper); }
  .drawing--paper { color: var(--ink); --d-bg: var(--paper-2); --d-grid: rgba(29, 26, 27, .06); --d-acc: var(--copper-ink); }
  .d-bg { fill: var(--d-bg); }
  .d-grid { fill: none; stroke: var(--d-grid); stroke-width: 1; }
  .d-crop path { fill: none; stroke: currentColor; stroke-opacity: .45; stroke-width: 1.5; }
  .d-line { fill: none; stroke: currentColor; stroke-opacity: .7; stroke-width: 1.5; }
  .d-faint { fill: none; stroke: currentColor; stroke-opacity: .28; stroke-width: 1.2; }
  .d-copper { fill: none; stroke: var(--d-acc); stroke-width: 2; }
  .d-dash { stroke-dasharray: 8 6; }
  .d-fill { fill: currentColor; fill-opacity: .22; stroke: none; }
  .d-solid { fill: var(--d-bg); }
  .d-copper.d-solid { fill: var(--d-acc); }
  .d-dim { fill: none; stroke: var(--d-acc); stroke-width: 1.2; }
  .d-label { font-family: var(--mono); font-size: 13px; letter-spacing: .08em; fill: currentColor; fill-opacity: .7; }

  .title-block {
    position: absolute; right: 0; bottom: 0;
    display: grid; grid-template-columns: auto auto; gap: 0;
    font-family: var(--mono); font-size: .6875rem; letter-spacing: .04em; line-height: 1.3;
    border-top: 1px solid currentColor; border-left: 1px solid currentColor;
    background: var(--d-bg);
  }
  .title-block > span { padding: 7px 10px; }
  .tb-ref { border-right: 1px solid currentColor; color: var(--d-acc); }
  .tb-title { text-transform: uppercase; }
  .tb-note { grid-column: 1 / -1; border-top: 1px solid currentColor; opacity: .7; }
</style>
