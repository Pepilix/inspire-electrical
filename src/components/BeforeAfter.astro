---
/**
 * Before-and-after comparison. A native range input drives the divide, so it works with
 * mouse, touch and keyboard (arrow keys) and is announced by screen readers.
 * Without JavaScript both images are shown side by side.
 */
import { Image } from 'astro:assets';

interface Props {
  before: ImageMetadata; beforeAlt: string;
  after: ImageMetadata; afterAlt: string;
  caption: string;
  beforeLabel?: string; afterLabel?: string;
}
const { before, beforeAlt, after, afterAlt, caption, beforeLabel = 'First fix', afterLabel = 'Handover' } = Astro.props;
const id = `ba-${Math.random().toString(36).slice(2, 8)}`;
---
<figure class="ba" data-ba style="--pos: 50%">
  <div class="ba-frame">
    <div class="ba-img ba-after"><Image src={after} alt={afterAlt} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 50vw" loading="lazy" /></div>
    <div class="ba-img ba-before"><Image src={before} alt={beforeAlt} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 50vw" loading="lazy" /></div>
    <span class="ba-tag ba-tag--before" aria-hidden="true">{beforeLabel}</span>
    <span class="ba-tag ba-tag--after" aria-hidden="true">{afterLabel}</span>
    <span class="ba-handle" aria-hidden="true"><span></span></span>
    <label class="visually-hidden" for={id}>Compare {beforeLabel.toLowerCase()} and {afterLabel.toLowerCase()}</label>
    <input class="ba-range" id={id} type="range" min="0" max="100" value="50" step="1" data-ba-range>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .ba { margin: 0; }
  .ba-frame { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper-2); user-select: none; touch-action: pan-y; }
  .ba-img { position: absolute; inset: 0; }
  .ba-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ba-before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba-tag { position: absolute; top: 14px; padding: 5px 10px; background: rgba(20, 20, 20, .72); color: #fff; font-size: .75rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; pointer-events: none; }
  .ba-tag--before { left: 14px; }
  .ba-tag--after { right: 14px; }
  .ba-handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: #fff; pointer-events: none; }
  .ba-handle span { position: absolute; top: 50%; left: 50%; width: 44px; height: 44px; margin: -22px 0 0 -22px; border-radius: 50%; background: #fff; box-shadow: 0 1px 6px rgba(0, 0, 0, .25); }
  .ba-handle span::before, .ba-handle span::after { content: ''; position: absolute; top: 50%; width: 7px; height: 7px; margin-top: -4px; border-top: 2px solid var(--ink); border-left: 2px solid var(--ink); }
  .ba-handle span::before { left: 11px; transform: rotate(-45deg); }
  .ba-handle span::after { right: 11px; transform: rotate(135deg); }
  .ba-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; pointer-events: none; }
  .ba-frame { cursor: ew-resize; }
  .ba-range:focus-visible + * , .ba-frame:focus-within .ba-handle span { outline: 2px solid var(--brass-ink); outline-offset: 2px; }
  figcaption { margin-top: 12px; font-size: .875rem; color: var(--ink-3); }

  /* Without JavaScript: show both images side by side */
  :global(html:not(.js)) .ba-frame { aspect-ratio: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; background: none; }
  :global(html:not(.js)) .ba-img { position: relative; aspect-ratio: 4 / 3; clip-path: none; }
  :global(html:not(.js)) .ba-before { order: -1; }
  :global(html:not(.js)) .ba-handle, :global(html:not(.js)) .ba-range { display: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((fig) => {
    const range = fig.querySelector<HTMLInputElement>('[data-ba-range]')!;
    const set = () => {
      fig.style.setProperty('--pos', `${range.value}%`);
      range.setAttribute('aria-valuetext', `${range.value}% first fix`);
    };
    range.addEventListener('input', set);
    // Click or drag anywhere on the photograph (mouse and touch), not just on the thin range track.
    const frame = fig.querySelector<HTMLElement>('.ba-frame')!;
    let dragging = false;
    const move = (e: PointerEvent) => {
      const r = frame.getBoundingClientRect();
      range.value = String(Math.round(Math.min(100, Math.max(0, ((e.clientX - r.left) / r.width) * 100))));
      set();
    };
    frame.addEventListener('pointerdown', (e) => { dragging = true; frame.setPointerCapture(e.pointerId); move(e); e.preventDefault(); range.focus({ preventScroll: true }); });
    frame.addEventListener('pointermove', (e) => { if (dragging) move(e); });
    frame.addEventListener('pointerup', () => { dragging = false; });
    frame.addEventListener('pointercancel', () => { dragging = false; });
    set();
  });
</script>
