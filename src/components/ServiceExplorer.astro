---
/**
 * Split-screen service explorer.
 * Without JavaScript every service panel is visible as a stacked list with its own heading and link,
 * so all content is crawlable and usable. With JavaScript it becomes a tab interface:
 * hover (mouse), click/tap and arrow keys select a service and the right-hand panel updates.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Drawing from './Drawing.astro';
import { href } from '../lib/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { id: 'domestic', label: 'For homes', items: services.filter((s) => s.data.group === 'domestic') },
  { id: 'projects', label: 'Projects and commercial', items: services.filter((s) => s.data.group === 'projects') },
];
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpg,jpeg,png,webp,avif}');
let n = 0;
---
<div class="explorer" data-explorer>
  <div class="ex-list" role="tablist" aria-label="Services" aria-orientation="vertical" data-ex-tablist>
    {groups.map((g) => (
      <div class="ex-group">
        <p class="ex-group-label mono">{g.label}</p>
        {g.items.map((s) => {
          n += 1;
          return (
            <button class="ex-tab" type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={n === 1 ? 'true' : 'false'} tabindex={n === 1 ? 0 : -1} data-ex-tab>
              <span class="ex-n mono">{String(n).padStart(2, '0')}</span>
              <span class="ex-name">{s.data.navTitle}</span>
              <span class="ex-line" aria-hidden="true"></span>
            </button>
          );
        })}
      </div>
    ))}
  </div>

  <div class="ex-panels">
    {await Promise.all(services.map(async (s, i) => {
      const img = s.data.image && photos[`/src/assets/${s.data.image}`] ? (await photos[`/src/assets/${s.data.image}`]()).default : null;
      return (
        <article class="ex-panel" id={`panel-${s.id}`} role="tabpanel" aria-labelledby={`tab-${s.id}`} data-ex-panel data-active={i === 0 ? '' : undefined}>
          <div class="ex-media">
            {img
              ? <Image src={img} alt={s.data.imageAlt ?? ''} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 50vw" loading="lazy" />
              : <Drawing kind={s.data.drawing} />}
          </div>
          <div class="ex-body">
            <p class="mono ex-kind">{s.data.group === 'domestic' ? 'For homes' : 'Projects and commercial'} · {s.data.audience}</p>
            <h3 class="h3 ex-title">{s.data.title}</h3>
            <p class="ex-summary">{s.data.summary}</p>
            <a class="text-link" href={href(`/services/${s.id}/`)}><span>{s.data.navTitle}: details</span><span class="arrow" aria-hidden="true"></span></a>
          </div>
        </article>
      );
    }))}
  </div>
</div>

<style>
  .explorer { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); align-items: start; }

  .ex-group + .ex-group { margin-top: 28px; }
  .ex-group-label { color: var(--copper); text-transform: uppercase; letter-spacing: .12em; font-size: .6875rem; padding-bottom: 10px; border-bottom: 1px solid var(--rule-dark); }
  .ex-tab {
    position: relative;
    display: grid; grid-template-columns: 2.4em 1fr; align-items: baseline; gap: 8px;
    width: 100%; padding: 12px 0;
    border: 0; border-bottom: 1px solid var(--rule-dark);
    background: none; color: var(--on-dark-2);
    text-align: left; cursor: pointer;
    transition: color .3s var(--ease);
  }
  .ex-n { font-size: .6875rem; color: inherit; opacity: .7; }
  .ex-name { font-family: var(--serif); font-size: clamp(1.375rem, 2vw, 1.75rem); font-weight: 500; line-height: 1.15; transition: transform .5s var(--ease-out); }
  .ex-line { position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--copper); transform: scaleX(0); transform-origin: left; transition: transform .6s var(--ease-out); }
  .ex-tab:hover, .ex-tab[aria-selected='true'] { color: var(--on-dark); }
  .ex-tab[aria-selected='true'] .ex-name { transform: translateX(10px); }
  .ex-tab[aria-selected='true'] .ex-line { transform: scaleX(1); }
  .ex-tab[aria-selected='true'] .ex-n { color: var(--copper); opacity: 1; }

  .ex-panels { position: sticky; top: calc(var(--header-h) + 24px); }
  .ex-media { aspect-ratio: 4 / 3; overflow: hidden; background: var(--charcoal-2); }
  .ex-media :global(img), .ex-media :global(.drawing) { width: 100%; height: 100%; object-fit: cover; }
  .ex-body { padding-top: 24px; max-width: 34em; }
  .ex-kind { color: var(--on-dark-2); font-size: .75rem; }
  .ex-title { margin-top: 10px; }
  .ex-summary { margin-top: 12px; color: var(--on-dark-2); font-size: 1.0625rem; }
  .ex-body .text-link { margin-top: 20px; color: var(--copper); }

  /* Without JS: the tab list is not needed; every panel is shown in turn */
  :global(html:not(.js)) .ex-list { display: none; }
  :global(html:not(.js)) .explorer { grid-template-columns: 1fr; }
  :global(html:not(.js)) .ex-panels { position: static; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 48px 32px; }

  /* With JS: one panel at a time, cross-fading */
  :global(.js) .ex-panels { display: grid; }
  :global(.js) .ex-panel { grid-area: 1 / 1; visibility: hidden; opacity: 0; transition: opacity .5s var(--ease), visibility 0s .5s; }
  :global(.js) .ex-panel[data-active] { visibility: visible; opacity: 1; transition: opacity .5s var(--ease); }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ex-panel .ex-media { clip-path: inset(0 0 0 100%); transition: clip-path .8s var(--ease-out); }
    :global(.js) .ex-panel[data-active] .ex-media { clip-path: inset(0 0 0 0); }
    :global(.js) .ex-panel .ex-body { transform: translateY(12px); transition: transform .7s var(--ease-out) .1s; }
    :global(.js) .ex-panel[data-active] .ex-body { transform: none; }
  }

  /* Phones: the list becomes horizontal chips above the panel */
  @media (max-width: 860px) {
    .explorer { grid-template-columns: 1fr; gap: 24px; }
    :global(.js) .ex-list { display: flex; gap: 0; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scrollbar-width: none; }
    :global(.js) .ex-list::-webkit-scrollbar { display: none; }
    :global(.js) .ex-group { display: flex; flex: none; align-items: stretch; margin: 0 !important; }
    :global(.js) .ex-group-label { display: none; }
    :global(.js) .ex-tab { flex: none; width: auto; grid-template-columns: auto; padding: 10px 14px; border: 1px solid var(--rule-dark); margin-right: 6px; scroll-snap-align: start; }
    :global(.js) .ex-tab .ex-n { display: none; }
    :global(.js) .ex-tab .ex-name { font-family: var(--sans); font-size: .9375rem; transform: none !important; white-space: nowrap; }
    :global(.js) .ex-tab[aria-selected='true'] { border-color: var(--copper); background: var(--charcoal-2); }
    :global(.js) .ex-tab .ex-line { display: none; }
    .ex-panels { position: static; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ex-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-ex-panel]'));
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    let hoverTimer: number | undefined;

    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        const on = k === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[k].toggleAttribute('data-active', on);
        panels[k].toggleAttribute('hidden', false);
      });
      if (focus) tabs[i].focus();
      // keep the selected chip in view on phones
      tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('mouseenter', () => {
        if (!finePointer.matches) return;
        window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => select(i), 90);
      });
      t.addEventListener('mouseleave', () => window.clearTimeout(hoverTimer));
      t.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
        if (e.key in keys) { e.preventDefault(); select((i + keys[e.key] + tabs.length) % tabs.length, true); }
        if (e.key === 'Home') { e.preventDefault(); select(0, true); }
        if (e.key === 'End') { e.preventDefault(); select(tabs.length - 1, true); }
      });
    });
  });
</script>
