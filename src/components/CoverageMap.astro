---
/**
 * Coverage map drawn as a lightweight SVG from real coordinates (equirectangular projection,
 * corrected for latitude). No map tiles or mapping library.
 * Priority towns link to their own pages; other towns link to their section on /areas-we-cover/.
 * The Inspire studio is marked as the group's base, not as an Inspire Electrical office.
 */
import { towns, studio } from '../data/areas';
import { href } from '../lib/site';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const W = 640, H = 520, PAD = 70;
const lat0 = 53.86, lat1 = 54.26, lng0 = -1.62, lng1 = -1.02;
const kx = Math.cos(((lat0 + lat1) / 2) * Math.PI / 180);
const spanX = (lng1 - lng0) * kx, spanY = lat1 - lat0;
const scale = Math.min((W - PAD * 2) / spanX, (H - PAD * 2) / spanY);
const offX = (W - spanX * scale) / 2, offY = (H - spanY * scale) / 2;
const px = (lat: number, lng: number) => ({ x: offX + (lng - lng0) * kx * scale, y: offY + (lat1 - lat) * scale });

const points = towns.map((t) => ({ ...t, ...px(t.lat, t.lng) }));
const base = px(studio.lat, studio.lng);
// 1 degree of latitude is about 111.2 km
const kmPx = scale / 111.2;
const scaleBar = 10 * kmPx;

// Coverage outline: padded convex hull of all towns
function hull(p: { x: number; y: number }[]) {
  const s = [...p].sort((a, b) => a.x - b.x || a.y - b.y);
  const cross = (o: any, a: any, b: any) => (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x);
  const lo: any[] = [], up: any[] = [];
  for (const q of s) { while (lo.length >= 2 && cross(lo[lo.length - 2], lo[lo.length - 1], q) <= 0) lo.pop(); lo.push(q); }
  for (const q of [...s].reverse()) { while (up.length >= 2 && cross(up[up.length - 2], up[up.length - 1], q) <= 0) up.pop(); up.push(q); }
  return [...lo.slice(0, -1), ...up.slice(0, -1)];
}
const h = hull(points);
const cx = h.reduce((a, p) => a + p.x, 0) / h.length, cy = h.reduce((a, p) => a + p.y, 0) / h.length;
const padded = h.map((p) => { const dx = p.x - cx, dy = p.y - cy, d = Math.hypot(dx, dy); return { x: p.x + (dx / d) * 34, y: p.y + (dy / d) * 34 }; });
// smooth closed path through padded hull points
const mid = (a: any, b: any) => ({ x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 });
let d = '';
padded.forEach((p, i) => {
  const next = padded[(i + 1) % padded.length];
  const m = mid(p, next);
  d += i === 0 ? `M${mid(padded[padded.length - 1], p).x.toFixed(1)} ${mid(padded[padded.length - 1], p).y.toFixed(1)} ` : '';
  d += `Q${p.x.toFixed(1)} ${p.y.toFixed(1)} ${m.x.toFixed(1)} ${m.y.toFixed(1)} `;
});
d += 'Z';

const labelSide: Record<string, 'l' | 'r'> = { harrogate: 'l', ripon: 'l', knaresborough: 'r', boroughbridge: 'r', thirsk: 'r', york: 'r', wetherby: 'l', tadcaster: 'r' };
const link = (t: (typeof points)[number]) => href(t.priority ? `/areas/${t.id}/` : `/areas-we-cover/#${t.id}`);
---
<div class:list={['coverage', { 'coverage--compact': compact }]} data-coverage>
  <figure class="map">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="map-title map-desc">
      <title id="map-title">Map of the area Inspire Electrical covers</title>
      <desc id="map-desc">Harrogate, York and Wetherby are the main areas, with Knaresborough, Ripon, Boroughbridge, Tadcaster and Thirsk also covered. The Inspire group studio is at Thorp Arch near Wetherby.</desc>
      <defs>
        <pattern id="map-grid" width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0V32" fill="none" class="m-grid" /></pattern>
      </defs>
      <rect width={W} height={H} fill="url(#map-grid)" />
      <path d={d} class="m-area" />
      {points.filter((t) => !t.priority).map((t) => {
        const near = points.find((p) => p.id === t.near)!;
        return <line x1={near.x} y1={near.y} x2={t.x} y2={t.y} class="m-link" />;
      })}
      <line x1={points[0].x} y1={points[0].y} x2={points[2].x} y2={points[2].y} class="m-spine" />
      <line x1={points[2].x} y1={points[2].y} x2={points[1].x} y2={points[1].y} class="m-spine" />

      <g class="m-studio">
        <rect x={base.x - 5} y={base.y - 5} width="10" height="10" transform={`rotate(45 ${base.x} ${base.y})`} />
        <text x={base.x - 10} y={base.y + 24} text-anchor="end">INSPIRE STUDIO</text>
      </g>

      {points.map((t) => (
        <a href={link(t)} class:list={['m-town', { 'is-priority': t.priority }]} data-town={t.id} aria-label={t.priority ? `Electricians in ${t.name}` : `${t.name}: coverage details`}>
          {t.priority && <circle cx={t.x} cy={t.y} r="22" class="m-ring" />}
          <circle cx={t.x} cy={t.y} r={t.priority ? 7 : 4.5} class="m-dot" />
          <text x={labelSide[t.id] === 'l' ? t.x - (t.priority ? 28 : 14) : t.x + (t.priority ? 28 : 14)} y={t.y + 5} text-anchor={labelSide[t.id] === 'l' ? 'end' : 'start'} class="m-label">{t.name}</text>
        </a>
      ))}

      <g class="m-key">
        <path d={`M${W - 40} 40v34M${W - 40} 40l-7 12M${W - 40} 40l7 12`} />
        <text x={W - 40} y="92" text-anchor="middle">N</text>
        <path d={`M40 ${H - 40}h${scaleBar.toFixed(1)}M40 ${H - 46}v12M${(40 + scaleBar).toFixed(1)} ${H - 46}v12`} />
        <text x="40" y={H - 54}>10 KM</text>
      </g>
    </svg>
  </figure>

  {!compact && (
    <div class="map-list">
      <p class="mono map-label">Main areas</p>
      <ul role="list">
        {points.filter((t) => t.priority).map((t) => (
          <li><a href={link(t)} data-town={t.id}><span class="ml-name">{t.name}</span><span class="arrow" aria-hidden="true"></span></a></li>
        ))}
      </ul>
      <p class="mono map-label">Also covering</p>
      <ul role="list" class="map-secondary">
        {points.filter((t) => !t.priority).map((t) => (
          <li><a href={link(t)} data-town={t.id}>{t.name}</a></li>
        ))}
      </ul>
      <p class="map-note">And the villages between them. If you are not sure whether we cover your address, <a href={href('/contact/')}>ask</a>.</p>
    </div>
  )}
</div>

<style>
  .coverage { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .coverage--compact { grid-template-columns: 1fr; }
  .map { margin: 0; color: var(--ink); }
  .map svg { width: 100%; height: auto; overflow: visible; }
  .m-grid { stroke: currentColor; stroke-opacity: .07; }
  .m-area { fill: var(--brass-ink); fill-opacity: .06; stroke: var(--brass-ink); stroke-width: 1.2; stroke-dasharray: 6 5; }
  .m-spine { stroke: var(--brass-ink); stroke-width: 1.6; }
  .m-link { stroke: currentColor; stroke-opacity: .35; stroke-width: 1; stroke-dasharray: 2 4; }
  .m-studio rect { fill: var(--paper); stroke: currentColor; stroke-width: 1.2; }
  .m-studio text { font-family: var(--mono); font-size: 10px; letter-spacing: .1em; fill: currentColor; fill-opacity: .7; }
  .m-dot { fill: var(--paper); stroke: currentColor; stroke-width: 1.4; transition: fill .3s, r .3s; }
  .is-priority .m-dot { fill: var(--brass-ink); stroke: var(--brass-ink); }
  .m-ring { fill: none; stroke: var(--brass-ink); stroke-opacity: .4; stroke-width: 1; transform-box: fill-box; transform-origin: center; transition: transform .5s var(--ease-out), stroke-opacity .3s; }
  .m-label { font-family: var(--sans); font-size: 15px; font-weight: 500; fill: currentColor; }
  .is-priority .m-label { font-family: var(--serif); font-size: 22px; font-weight: 600; }
  .m-town { cursor: pointer; outline: none; }
  .m-town:hover .m-dot, .m-town:focus-visible .m-dot, :global(.m-town.is-hot) .m-dot { fill: var(--brass-ink); }
  .m-town:hover .m-ring, .m-town:focus-visible .m-ring, :global(.m-town.is-hot) .m-ring { transform: scale(1.35); stroke-opacity: 1; }
  .m-town:hover .m-label, .m-town:focus-visible .m-label, :global(.m-town.is-hot) .m-label { fill: var(--brass-ink); text-decoration: underline; }
  .m-key path { fill: none; stroke: currentColor; stroke-width: 1.2; }
  .m-key text { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; fill: currentColor; }


  .map-label { color: var(--brass-ink); text-transform: uppercase; letter-spacing: .12em; font-size: .6875rem; margin: 28px 0 10px; }
  .map-label:first-child { margin-top: 0; }
  .map-list ul:not(.map-secondary) { border-top: 1px solid var(--rule-strong); }
  .map-list ul:not(.map-secondary) a { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .ml-name { font-family: var(--serif); font-size: 2rem; line-height: 1; font-weight: 500; }
  .map-list a:hover .ml-name, :global(.map-list a.is-hot) .ml-name { color: var(--brass-ink); }
  .map-secondary { display: flex; flex-wrap: wrap; gap: 8px; }
  .map-secondary a { display: inline-block; padding: 7px 12px; border: 1px solid var(--rule); text-decoration: none; font-size: .9375rem; transition: border-color .2s; }
  .map-secondary a:hover, :global(.map-secondary a.is-hot) { border-color: var(--brass-ink); color: var(--brass-ink); }
  .map-note { margin-top: 20px; color: var(--ink-2); font-size: .9375rem; }
  .map-note a { color: var(--brass-ink); }

  @media (max-width: 860px) {
    .coverage { grid-template-columns: 1fr; }
    .m-label { font-size: 24px; }
    .is-priority .m-label { font-size: 32px; }
    .m-studio text, .m-key text { font-size: 16px; }
    .m-dot { stroke-width: 2; }
  }
</style>

<script>
  // Hovering a town on the map highlights it in the list, and the reverse.
  document.querySelectorAll<HTMLElement>('[data-coverage]').forEach((root) => {
    const all = Array.from(root.querySelectorAll<HTMLElement | SVGElement>('[data-town]'));
    const set = (id: string | null) => all.forEach((el) => el.classList.toggle('is-hot', el.dataset.town === id));
    all.forEach((el) => {
      el.addEventListener('mouseenter', () => set(el.dataset.town!));
      el.addEventListener('mouseleave', () => set(null));
      el.addEventListener('focus', () => set(el.dataset.town!));
      el.addEventListener('blur', () => set(null));
    });
  });
</script>
