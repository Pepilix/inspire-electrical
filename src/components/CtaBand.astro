---
// Closing contact section at the foot of most pages: the site's second dark band.
import Verify from './Verify.astro';
import { company } from '../data/company';
import { href, showPlaceholders } from '../lib/site';

interface Props { title?: string; text?: string; context?: string }
const {
  title = 'Planning electrical work? Let’s talk.',
  text = 'Tell us what you need, from one extra socket to a full new-build installation, and we will come back to you.',
  context = 'band',
} = Astro.props;
---
<section class="cta ground-dark" aria-labelledby={`cta-${context}`}>
  <div class="wrap cta-grid">
    <h2 class="h2 cta-title" id={`cta-${context}`}>{title}</h2>
    <div class="cta-body">
      <p class="cta-text">{text}</p>
      <div class="cta-actions">
        <a class="btn btn--light" href={href('/contact/?type=domestic')} data-track="cta_click" data-cta={`${context}_domestic`}>Domestic enquiry</a>
        <a class="btn" href={href('/contact/?type=project')} data-track="cta_click" data-cta={`${context}_project`}>Project enquiry</a>
      </div>
      {(company.phone || company.email || showPlaceholders) && (
        <p class="cta-direct">
          {company.phone ? <a href={`tel:${company.phone.e164}`} data-track="phone_click">{company.phone.display}</a> : <Verify label="Telephone" />}
          {company.email ? <a href={`mailto:${company.email}`} data-track="email_click">{company.email}</a> : <Verify label="Email" />}
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(64px, 9vw, 120px); }
  .cta-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px clamp(40px, 7vw, 112px); align-items: end; }
  .cta-title { font-size: clamp(2.25rem, 4.6vw, 4rem); max-width: 14ch; }
  .cta-text { color: var(--on-dark-2); }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .cta-direct { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 22px; font-size: 1.0625rem; }
  .cta-direct a { color: var(--on-dark); text-underline-offset: 4px; }
  @media (max-width: 860px) { .cta-grid { grid-template-columns: 1fr; } }
</style>
