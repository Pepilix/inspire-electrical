---
// Closing call to action used at the foot of most pages.
import Verify from './Verify.astro';
import { company } from '../data/company';
import { href, showPlaceholders } from '../lib/site';

interface Props { title?: string; text?: string; context?: string }
const {
  title = 'Planning electrical work? Let’s talk.',
  text = 'Tell us what you need, from one extra socket to a full new-build installation. We will reply to arrange a conversation or a visit.',
  context = 'band',
} = Astro.props;
---
<section class="cta ground-dark" aria-labelledby={`cta-${context}`}>
  <div class="wrap cta-grid">
    <div>
      <p class="eyebrow">Next step</p>
      <h2 class="h2 cta-title" id={`cta-${context}`} data-reveal>{title}</h2>
    </div>
    <div class="cta-body" data-reveal data-reveal-delay="1">
      <p class="lead">{text}</p>
      <div class="cta-routes">
        <a class="route" href={href('/contact/?type=domestic')} data-track="cta_click" data-cta={`${context}_domestic`}>
          <span class="mono">For your home</span>
          <span class="route-title">Domestic enquiry</span>
          <span class="arrow" aria-hidden="true"></span>
        </a>
        <a class="route" href={href('/contact/?type=project')} data-track="cta_click" data-cta={`${context}_project`}>
          <span class="mono">Builds, renovations, commercial</span>
          <span class="route-title">Project enquiry</span>
          <span class="arrow" aria-hidden="true"></span>
        </a>
      </div>
      {(company.phone || company.email || showPlaceholders) && <p class="cta-direct">
        {company.phone ? <a href={`tel:${company.phone.e164}`} data-track="phone_click">{company.phone.display}</a> : <Verify label="Telephone" />}
        {company.email ? <a href={`mailto:${company.email}`} data-track="email_click">{company.email}</a> : <Verify label="Email" />}
      </p>}
    </div>
  </div>
</section>

<style>
  .cta { padding-block: var(--section); border-top: 1px solid var(--rule-dark); }
  .cta-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px clamp(40px, 7vw, 120px); align-items: end; }
  .cta-title { margin-top: 20px; font-size: clamp(2.5rem, 5.4vw, 4.75rem); }
  .cta-routes { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 32px; }
  .route {
    position: relative; display: grid; gap: 8px; align-content: start;
    padding: 22px 22px 52px;
    border: 1px solid var(--rule-dark);
    text-decoration: none;
    transition: border-color .3s, background-color .3s;
  }
  .route .mono { color: var(--on-dark-2); font-size: .75rem; }
  .route-title { font-family: var(--serif); font-size: 1.75rem; line-height: 1.05; }
  .route .arrow { position: absolute; left: 22px; bottom: 24px; color: var(--copper); }
  .route:hover { border-color: var(--copper); background: var(--charcoal-2); }
  .cta-direct { display: flex; gap: 12px 28px; flex-wrap: wrap; margin-top: 24px; font-family: var(--mono); font-size: .9375rem; }
  .cta-direct a { color: var(--on-dark); text-underline-offset: 4px; }
  @media (max-width: 860px) {
    .cta-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 420px) {
    .cta-routes { grid-template-columns: 1fr; }
  }
</style>
