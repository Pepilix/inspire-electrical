---
// Homepage hero. The headline, location line and both calls to action are plain HTML and
// visible from first paint; only the drawing and the headline lines animate.
// The right-hand area is a live single-line diagram until real hero photography or video exists
// (see docs/image-assets.md for the slot specification).
import { href } from '../lib/site';
---
<section class="hero ground-dark" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">Inspire Electrical · Harrogate · York · Wetherby</p>
      <h1 class="display hero-title" id="hero-title">
        <span class="line"><span>Electrical</span></span>
        <span class="line"><span>installation.</span></span>
        <span class="line"><span><em>Done properly.</em></span></span>
      </h1>
      <p class="lead hero-lead">Professional electrical services for homes, businesses and developments across Harrogate, York, Wetherby and North Yorkshire.</p>
      <div class="hero-ctas">
        <a class="btn" href={href('/contact/')} data-track="cta_click" data-cta="hero_primary">Discuss your project <span class="arrow" aria-hidden="true"></span></a>
        <a class="btn btn--ghost" href={href('/#services')} data-cta="hero_services">Explore our services</a>
      </div>
      <ul role="list" class="hero-routes">
        <li><a href={href('/contact/?type=domestic')} data-track="cta_click" data-cta="hero_homes"><span class="mono">Homeowners</span><span>Extra sockets to full rewires</span><span class="arrow" aria-hidden="true"></span></a></li>
        <li><a href={href('/contact/?type=project')} data-track="cta_click" data-cta="hero_projects"><span class="mono">Architects, builders, developers</span><span>Design to handover</span><span class="arrow" aria-hidden="true"></span></a></li>
      </ul>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <svg class="sld" viewBox="0 0 560 640" preserveAspectRatio="xMidYMid meet">
        <defs>
          <pattern id="hero-grid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" fill="none" stroke="rgba(241,238,232,.05)" /></pattern>
        </defs>
        <rect width="560" height="640" fill="url(#hero-grid)" />
        <g class="sld-frame"><path d="M14 44V14H44M516 14H546V44M14 596V626H44M516 626H546V596" /></g>
        <!-- supply, main switch, busbar, outgoing ways -->
        <g class="sld-wire">
          <path pathLength="1" d="M80 70V150" />
          <path pathLength="1" d="M80 210V250H480" />
          {[0, 1, 2, 3, 4].map((i) => <path pathLength="1" d={`M${120 + i * 80} 250V${330 + (i % 2) * 40}`} />)}
          <path pathLength="1" d="M120 370V520H210" />
          <path pathLength="1" d="M200 410V470H300V560" />
          <path pathLength="1" d="M280 370V450H420V520" />
          <path pathLength="1" d="M360 410V430H500V470" />
          <path pathLength="1" d="M440 370V600" />
        </g>
        <g class="sld-devices">
          <circle cx="80" cy="56" r="14" />
          <rect x="62" y="150" width="36" height="60" />
          <path d="M70 200L90 160" class="sld-copper" />
          {[0, 1, 2, 3, 4].map((i) => <rect x={108 + i * 80} y={330 + (i % 2) * 40} width="24" height="40" />)}
        </g>
        <g class="sld-ends">
          {[[210, 520], [300, 560], [420, 520], [500, 470], [440, 600]].map(([x, y], i) => (
            <circle cx={x} cy={y} r="9" style={`--d:${1.6 + i * .12}s`} />
          ))}
        </g>
        <g class="sld-labels">
          <text x="104" y="60">SUPPLY</text>
          <text x="108" y="185">MAIN SWITCH</text>
          <text x="388" y="240">BUSBAR</text>
          <text x="222" y="524">LIGHTING</text>
          <text x="312" y="564">POWER</text>
          <text x="402" y="545">GARDEN</text>
          <text x="514" y="474">EV</text>
          <text x="452" y="604">DATA</text>
        </g>
        <path class="sld-pulse" pathLength="1" d="M80 70V250H360V430H500V470" />
      </svg>
      <p class="hero-caption mono">Fig. 1: from the supply to every room</p>
    </div>
  </div>

  <div class="wrap">
    <dl class="hero-block">
      <div><dt>Coverage</dt><dd>Harrogate, York, Wetherby and North Yorkshire</dd></div>
      <div><dt>For</dt><dd>Homes, businesses, new builds and renovations</dd></div>
      <div><dt>Work</dt><dd>Installation, design, testing, maintenance</dd></div>
      <div><dt>Part of</dt><dd><a href="https://trustinspire.com/">Inspire</a>, working in homes since 2009</dd></div>
    </dl>
  </div>
</section>

<style>
  .hero { position: relative; padding-top: clamp(32px, 6vh, 72px); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 40px; align-items: center; }
  .hero-eyebrow { margin-bottom: clamp(24px, 4vh, 40px); }
  .hero-title .line { display: block; overflow: hidden; padding-bottom: .08em; margin-bottom: -.08em; }
  .hero-title .line > span { display: block; }
  .hero-title em { font-style: italic; color: var(--copper); }
  .hero-lead { margin-top: clamp(24px, 3.5vh, 36px); max-width: 32em; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  .hero-routes { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-top: 40px; max-width: 640px; border-top: 1px solid var(--rule-dark); }
  .hero-routes a {
    display: grid; gap: 4px; padding: 16px 20px 16px 0;
    text-decoration: none;
  }
  .hero-routes li + li a { padding-left: 20px; border-left: 1px solid var(--rule-dark); }
  .hero-routes .mono { font-size: .6875rem; text-transform: uppercase; letter-spacing: .1em; color: var(--on-dark-2); }
  .hero-routes .arrow { color: var(--copper); margin-top: 6px; }

  .hero-visual { position: relative; align-self: stretch; display: grid; align-content: center; }
  .sld { width: 100%; max-height: 72vh; }
  .sld-frame path { fill: none; stroke: rgba(241, 238, 232, .4); stroke-width: 1.2; }
  .sld-wire path { fill: none; stroke: rgba(241, 238, 232, .55); stroke-width: 1.4; }
  .sld-devices > * { fill: var(--charcoal); stroke: rgba(241, 238, 232, .7); stroke-width: 1.4; }
  .sld-devices .sld-copper { stroke: var(--copper); stroke-width: 2; }
  .sld-ends circle { fill: var(--copper); stroke: var(--copper); }
  .sld-labels text { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; fill: rgba(241, 238, 232, .6); }
  .sld-pulse { fill: none; stroke: var(--copper); stroke-width: 2.4; stroke-dasharray: 0 1; opacity: 0; }
  .hero-caption { position: absolute; right: 0; bottom: 0; color: var(--on-dark-2); font-size: .6875rem; }

  .hero-block {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(40px, 7vh, 72px);
    border-top: 1px solid var(--rule-dark);
  }
  .hero-block > div { padding: 18px 20px 24px 0; }
  .hero-block > div + div { padding-left: 20px; border-left: 1px solid var(--rule-dark); }
  .hero-block dt { font-family: var(--mono); font-size: .6875rem; letter-spacing: .1em; text-transform: uppercase; color: var(--copper); }
  .hero-block dd { margin-top: 6px; font-size: .9375rem; color: var(--on-dark); }
  .hero-block a { text-underline-offset: 3px; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero-title .line > span { animation: rise 1.1s var(--ease-out) both; }
    :global(.js) .hero-title .line:nth-child(2) > span { animation-delay: .1s; }
    :global(.js) .hero-title .line:nth-child(3) > span { animation-delay: .2s; }
    :global(.js) .sld-wire path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.4s var(--ease) .3s forwards; }
    :global(.js) .sld-wire path:nth-child(n+3) { animation-delay: .7s; }
    :global(.js) .sld-wire path:nth-child(n+8) { animation-delay: 1.1s; }
    :global(.js) .sld-devices > *, :global(.js) .sld-labels { animation: fade .8s var(--ease) .9s both; }
    :global(.js) .sld-ends circle { animation: pop .5s var(--ease-out) var(--d) both; transform-box: fill-box; transform-origin: center; }
    :global(.js) .sld-pulse { animation: pulse 5s var(--ease) 2.4s infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sld-pulse { display: none; }
  }
  @keyframes rise { from { transform: translateY(105%); } }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { from { opacity: 0; } }
  @keyframes pop { from { transform: scale(0); } }
  @keyframes pulse {
    0% { stroke-dasharray: 0 1; stroke-dashoffset: 0; opacity: 1; }
    45% { stroke-dasharray: .18 1; stroke-dashoffset: -.82; opacity: 1; }
    55%, 100% { stroke-dasharray: 0 1; stroke-dashoffset: -1; opacity: 0; }
  }

  @media (max-width: 1080px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { display: none; }
    .hero-block { grid-template-columns: 1fr 1fr; }
    .hero-block > div:nth-child(3) { padding-left: 0; border-left: 0; }
    .hero-block > div:nth-child(n+3) { border-top: 1px solid var(--rule-dark); }
  }
  @media (max-width: 560px) {
    .hero-routes { grid-template-columns: 1fr; }
    .hero-routes li + li a { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule-dark); }
    .hero-block { grid-template-columns: 1fr; }
    .hero-block > div + div { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule-dark); }
    .hero-block > div { padding: 12px 0 14px; }
  }
</style>
