---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { company } from '../data/company';
import { href, pagePath } from '../lib/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const domestic = services.filter((s) => s.data.group === 'domestic');
const projects = services.filter((s) => s.data.group === 'projects');
const current = pagePath(Astro.url.pathname);
const isActive = (p: string) => (p === '/' ? current === '/' : current.startsWith(p));

const links = [
  { label: 'Projects', path: '/projects/' },
  { label: 'Areas', path: '/areas-we-cover/' },
  { label: 'Advice', path: '/advice/' },
  { label: 'About', path: '/about/' },
  { label: 'Contact', path: '/contact/' },
];
---
<header class="site-header" data-header>
  <div class="wrap header-bar">
    <a class="brand" href={href('/')} aria-label={`${company.name}, home`}>
      <Logo />
    </a>

    <nav class="nav" aria-label="Main" id="site-nav">
      <ul role="list" class="nav-list">
        <li class="has-panel" data-panel-item>
          <a href={href('/services/')} class="nav-link" aria-current={isActive('/services/') ? 'page' : undefined}>Services</a>
          <button class="panel-toggle" type="button" aria-expanded="false" aria-controls="services-panel" data-panel-toggle>
            <span class="visually-hidden">Show services</span>
            <span class="chev" aria-hidden="true"></span>
          </button>
          <div class="services-panel" id="services-panel" data-panel>
            <div class="panel-inner">
              <div class="panel-col">
                <p class="panel-label mono">For homes</p>
                <ul role="list">
                  {domestic.map((s) => <li><a href={href(`/services/${s.id}/`)}>{s.data.navTitle}</a></li>)}
                </ul>
              </div>
              <div class="panel-col">
                <p class="panel-label mono">Projects and commercial</p>
                <ul role="list">
                  {projects.map((s) => <li><a href={href(`/services/${s.id}/`)}>{s.data.navTitle}</a></li>)}
                </ul>
              </div>
              <a class="panel-feature" href={href('/contact/?type=project')}>
                <span class="mono">Planning a build or renovation?</span>
                <span class="panel-feature-title">Send us the drawings</span>
                <span class="arrow" aria-hidden="true"></span>
              </a>
            </div>
          </div>
        </li>
        {links.map((l) => (
          <li><a href={href(l.path)} class="nav-link" aria-current={isActive(l.path) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      {company.phone && (
        <a class="header-phone" href={`tel:${company.phone.e164}`} data-track="phone_click">{company.phone.display}</a>
      )}
      {company.phone && (
        <a class="icon-btn only-mobile" href={`tel:${company.phone.e164}`} data-track="phone_click" aria-label={`Call ${company.phone.display}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        </a>
      )}
      {company.email && (
        <a class="icon-btn only-mobile" href={`mailto:${company.email}`} data-track="email_click" aria-label={`Email ${company.email}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        </a>
      )}
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="menu-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>

  <div class="mobile-menu ground-white" id="mobile-menu" data-menu hidden>
    <div class="wrap mobile-inner">
      <p class="mono mobile-label">Services: homes</p>
      <ul role="list" class="mobile-services">
        {domestic.map((s) => <li><a href={href(`/services/${s.id}/`)}>{s.data.navTitle}</a></li>)}
      </ul>
      <p class="mono mobile-label">Services: projects and commercial</p>
      <ul role="list" class="mobile-services">
        {projects.map((s) => <li><a href={href(`/services/${s.id}/`)}>{s.data.navTitle}</a></li>)}
      </ul>
      <ul role="list" class="mobile-main">
        {links.map((l) => <li><a href={href(l.path)}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: var(--white);
    color: var(--ink);
    border-bottom: 1px solid transparent;
    transition: border-color .3s var(--ease), transform .45s var(--ease-out);
  }
  .site-header { border-bottom-color: var(--rule); }
  :global(.site-header.is-hidden) { transform: translateY(-100%); }

  .header-bar { display: flex; align-items: center; gap: 32px; height: var(--header-h); }
  .brand { display: block; color: var(--ink); font-size: 24px; text-decoration: none; margin-right: auto; }

  .nav-list { display: flex; align-items: center; gap: clamp(20px, 2.4vw, 36px); }
  .nav-list > li { position: relative; display: flex; align-items: center; }
  .nav-link {
    position: relative;
    padding-block: 8px;
    font-size: .9375rem;
    text-decoration: none;
    color: var(--ink-2);
    transition: color .25s;
  }
  .nav-link::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 2px; height: 1px;
    background: var(--brass-ink);
    transform: scaleX(0); transform-origin: right;
    transition: transform .5s var(--ease-out);
  }
  .nav-link:hover, .nav-link[aria-current] { color: var(--ink); }
  .nav-link:hover::after, .nav-link[aria-current]::after { transform: scaleX(1); transform-origin: left; }

  .panel-toggle { display: grid; place-items: center; width: 24px; height: 32px; padding: 0; border: 0; background: none; color: var(--ink-2); cursor: pointer; }
  .chev { width: 7px; height: 7px; border-right: 1px solid currentColor; border-bottom: 1px solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform .3s var(--ease); }
  [aria-expanded='true'] .chev { transform: translateY(1px) rotate(-135deg); }

  /* Services panel: opens on hover (desktop) or via the toggle button (keyboard/touch) */
  .services-panel {
    position: fixed; left: 0; right: 0; top: var(--header-h);
    background: var(--white);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    visibility: hidden; opacity: 0;
    clip-path: inset(0 0 100% 0);
    transition: clip-path .55s var(--ease-out), opacity .3s var(--ease), visibility 0s .55s;
  }
  .has-panel:hover .services-panel,
  :global(.has-panel.is-open) .services-panel {
    visibility: visible; opacity: 1; clip-path: inset(0 0 0 0);
    transition: clip-path .55s var(--ease-out), opacity .3s var(--ease), visibility 0s;
  }
  .panel-inner {
    max-width: var(--wrap); margin-inline: auto; padding: 40px var(--gutter) 48px;
    display: grid; grid-template-columns: 1fr 1fr 1.1fr; gap: 48px;
  }
  .panel-label { color: var(--brass-ink); margin-bottom: 14px; text-transform: uppercase; font-size: .7rem; letter-spacing: .12em; }
  .panel-col a { display: block; padding: 7px 0; font-family: var(--serif); font-size: 1.375rem; font-weight: 500; text-decoration: none; color: var(--ink); transition: color .2s, transform .4s var(--ease-out); }
  .panel-col a:hover { color: var(--brass-ink); transform: translateX(6px); }
  .panel-feature {
    display: grid; align-content: end; gap: 10px;
    padding: 28px; min-height: 220px;
    border: 1px solid var(--rule);
    text-decoration: none;
    background: var(--paper);
  }
  .panel-feature .mono { color: var(--ink-2); }
  .panel-feature-title { font-family: var(--serif); font-size: 2rem; line-height: 1.05; }

  .header-actions { display: flex; align-items: center; gap: 12px; }
  .header-phone { font-family: var(--mono); font-size: .875rem; text-decoration: none; color: var(--ink); margin-right: 8px; }
  .header-cta { min-height: 44px; padding: 10px 20px; font-size: .9375rem; }

  .icon-btn { display: none; place-items: center; width: 44px; height: 44px; color: var(--ink); }
  .icon-btn svg { width: 22px; height: 22px; }

  .menu-toggle { display: none; place-items: center; width: 44px; height: 44px; margin-right: -10px; padding: 0; border: 0; background: none; color: var(--ink); cursor: pointer; }
  .menu-icon, .menu-icon::before, .menu-icon::after { display: block; width: 24px; height: 1.5px; background: currentColor; transition: transform .35s var(--ease-out), background-color .2s; }
  .menu-icon { position: relative; }
  .menu-icon::before, .menu-icon::after { content: ''; position: absolute; left: 0; }
  .menu-icon::before { top: -7px; }
  .menu-icon::after { top: 7px; }
  [aria-expanded='true'] > .menu-icon { background-color: transparent; }
  [aria-expanded='true'] > .menu-icon::before { transform: translateY(7px) rotate(45deg); }
  [aria-expanded='true'] > .menu-icon::after { transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu {
    position: fixed; inset: var(--header-h) 0 0; z-index: 99;
    overflow-y: auto; overscroll-behavior: contain;
    border-top: 1px solid var(--rule);
  }
  .mobile-inner { padding-block: 24px 120px; }
  .mobile-label { color: var(--brass-ink); text-transform: uppercase; font-size: .7rem; letter-spacing: .12em; margin: 20px 0 6px; }
  .mobile-services a { display: block; padding: 7px 0; font-size: 1.0625rem; text-decoration: none; color: var(--ink); }
  .mobile-main { margin-top: 24px; border-top: 1px solid var(--rule); }
  .mobile-main a { display: block; padding: 14px 0; border-bottom: 1px solid var(--rule); font-family: var(--serif); font-size: 1.875rem; text-decoration: none; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.mobile-menu.is-open) li { animation: menu-in .6s var(--ease-out) both; }
    :global(.mobile-menu.is-open) li:nth-child(2) { animation-delay: .03s; }
    :global(.mobile-menu.is-open) li:nth-child(3) { animation-delay: .06s; }
    :global(.mobile-menu.is-open) li:nth-child(4) { animation-delay: .09s; }
    :global(.mobile-menu.is-open) li:nth-child(5) { animation-delay: .12s; }
  }
  @keyframes menu-in { from { opacity: 0; transform: translateY(10px); } }

  @media (max-width: 1080px) {
    .nav, .header-phone { display: none; }
    .menu-toggle, .icon-btn { display: grid; }
    .brand { font-size: 19px; }
  }
  @media (min-width: 1081px) {
    .mobile-menu { display: none !important; }
  }
</style>
