---
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { href, absolute } from '../../lib/site';
import { breadcrumbSchema, webPageSchema, businessRef } from '../../lib/schema';

export async function getStaticPaths() {
  const articles = await getCollection('advice');
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const d = article.data;
const { Content, headings } = await render(article);
const services = await getEntries(d.services);
const path = `/advice/${article.id}/`;
const crumbs = [{ label: 'Advice', path: '/advice/' }, { label: d.title, path }];
const fmt = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const schema = [
  webPageSchema(path, d.seoTitle, d.description, Astro.site),
  breadcrumbSchema(crumbs, Astro.site),
  {
    '@type': 'Article',
    '@id': `${absolute(path, Astro.site)}#article`,
    headline: d.title,
    description: d.description,
    datePublished: d.published.toISOString().slice(0, 10),
    dateModified: (d.updated ?? d.published).toISOString().slice(0, 10),
    author: businessRef(Astro.site),
    publisher: businessRef(Astro.site),
    mainEntityOfPage: absolute(path, Astro.site),
    inLanguage: 'en-GB',
    ...(d.sources.length && { citation: d.sources.map((s) => s.url) }),
  },
];
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={d.seoTitle} description={d.description} ogType="article" schema={schema}>
  <PageHeader eyebrow="Advice" title={d.title} lead={d.summary} crumbs={crumbs} />

  <section class="section ground-paper">
    <div class="wrap art-grid">
      <aside class="art-meta" aria-label="About this article">
        <dl class="schedule">
          <div><dt>Published</dt><dd><time datetime={d.published.toISOString().slice(0, 10)}>{fmt(d.published)}</time></dd></div>
          {d.updated && <div><dt>Updated</dt><dd><time datetime={d.updated.toISOString().slice(0, 10)}>{fmt(d.updated)}</time></dd></div>}
        </dl>
        {toc.length > 2 && (
          <nav class="toc" aria-label="On this page">
            <p class="mono toc-label">On this page</p>
            <ol role="list">{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
      </aside>

      <article class="prose art-body">
        <Content />

        {d.sources.length > 0 && (
          <section class="sources" aria-labelledby="sources-title">
            <h2 id="sources-title">Sources</h2>
            <ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}</ul>
            <p class="disclaimer">This guide is general information, not advice for a specific installation. Regulations change: check the sources above for the current position.</p>
          </section>
        )}
      </article>
    </div>
  </section>

  {services.length > 0 && (
    <section class="section--tight ground-white">
      <div class="wrap">
        <h2 class="h3">Related services</h2>
        <ul role="list" class="art-services">
          {services.map((s) => <li><a class="text-link" href={href(`/services/${s.id}/`)}><span>{s.data.navTitle}</span><span class="arrow" aria-hidden="true"></span></a></li>)}
        </ul>
      </div>
    </section>
  )}

  <CtaBand context="article" />
</Base>

<style>
  .art-grid { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 8fr); gap: 48px clamp(40px, 6vw, 96px); align-items: start; }
  .art-meta { position: sticky; top: calc(var(--header-h) + 24px); display: grid; gap: 32px; }
  .toc-label { color: var(--copper-ink); text-transform: uppercase; letter-spacing: .12em; font-size: .6875rem; margin-bottom: 10px; }
  .toc ol { display: grid; gap: 4px; }
  .toc a { display: block; padding: 4px 0; font-size: .875rem; color: var(--ink-2); text-decoration: none; }
  .toc a:hover { color: var(--copper-ink); }
  .art-body { max-width: 42em; }
  .sources { margin-top: 3em; padding-top: 2em; border-top: 1px solid var(--rule-strong); }
  .sources h2 { margin-top: 0 !important; font-size: 1.5rem !important; }
  .disclaimer { color: var(--ink-3); font-size: .875rem; }
  .art-services { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 12px 36px; }
  @media (max-width: 960px) {
    .art-grid { grid-template-columns: 1fr; }
    .art-meta { position: static; }
  }
</style>
