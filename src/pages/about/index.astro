---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Process from '../../components/Process.astro';
import Credentials from '../../components/Credentials.astro';
import Verify from '../../components/Verify.astro';
import CtaBand from '../../components/CtaBand.astro';
import { company } from '../../data/company';
import { breadcrumbSchema, webPageSchema } from '../../lib/schema';
import firstFix from '../../assets/group/yarm-first-fix.jpg';
import cinema from '../../assets/group/yarm-cinema.webp';

const title = 'About Inspire Electrical | Part of the Inspire Group';
const description = 'Inspire Electrical is the electrical contracting business of Inspire, the group behind Inspire Audio Visual and Care Home WiFi, based near Wetherby.';
const crumbs = [{ label: 'About', path: '/about/' }];
const family = [
  { name: 'Inspire Electrical', url: null, what: 'Electrical installation, design, testing and maintenance for homes, businesses and developments.', you: true },
  ...company.group.siblings.map((s) => ({ name: s.name, url: s.url, what: s.what, you: false })),
];
---
<Base title={title} description={description} schema={[webPageSchema('/about/', title, description, Astro.site), breadcrumbSchema(crumbs, Astro.site)]}>
  <PageHeader eyebrow="About" title="A new electrical business with an established team behind it." lead={`Inspire Electrical is part of Inspire, which has designed and installed technology in demanding homes since ${company.group.since}.`} crumbs={crumbs} />

  <section class="section ground-paper">
    <div class="wrap about-grid">
      <div class="prose">
        <h2>Why Inspire Electrical exists</h2>
        <p>Inspire began in {company.group.since}, wiring and programming smart homes. Inspire Audio Visual built its reputation on technically demanding smart home, lighting and cinema installations: work where the cabling, the programming and the finish all have to be right, and where the client expects the installer to still be around years later.</p>
        <p>That work depends on the electrical installation underneath it. Inspire Electrical brings electrical contracting into the same group, so homeowners, architects and builders can work with one team that understands both the electrics and the technology that runs on them.</p>
        <h2>What that means in practice</h2>
        <ul>
          <li><strong>Design comes first.</strong> Layouts, circuits and lighting are worked out before work starts.</li>
          <li><strong>Coordination is part of the job.</strong> We plan positions and timings with the other trades on site.</li>
          <li><strong>Lighting and control are understood.</strong> Wiring for lighting control, AV and data is planned in from first fix.</li>
          <li><strong>The paperwork is done properly.</strong> Certificates, notification and records for every job.</li>
          <li><strong>Small jobs matter.</strong> An extra socket gets the same checks as a new house.</li>
        </ul>
        <h2>Who you will deal with</h2>
        <p><Verify label="Names, roles and qualifications of the Inspire Electrical team (with photographs, if they are happy to be shown)" /></p>
      </div>
      <figure class="about-fig">
        <div data-reveal="clip"><Image src={firstFix} alt="A room at first fix with roof trusses, block walls and new stud framing" widths={[480, 800]} sizes="(max-width: 960px) 90vw, 36vw" loading="lazy" /></div>
        <div data-reveal="clip" data-reveal-delay="2"><Image src={cinema} alt="The same room finished as a home cinema" widths={[480, 800]} sizes="(max-width: 960px) 90vw, 36vw" loading="lazy" /></div>
        <figcaption class="mono">Inspire Audio Visual project, Yarm, at first fix and at handover. Group work, shown to illustrate the standard of installation.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section ground-white" aria-labelledby="family-title">
    <div class="wrap">
      <p class="eyebrow">The Inspire group</p>
      <h2 class="h2 fam-h" id="family-title">Three businesses, one standard.</h2>
      <ul role="list" class="family">
        {family.map((f, i) => (
          <li class:list={{ you: f.you }}>
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="fam-name">{f.name}</span>
            <span class="fam-what">{f.what}</span>
            {f.url ? <a class="text-link" href={f.url}><span>{new URL(f.url).hostname.replace('www.', '')}</span><span class="arrow" aria-hidden="true"></span></a> : <span class="mono fam-here">You are here</span>}
          </li>
        ))}
      </ul>
      <p class="fam-note">The group website is <a href={company.group.url}>trustinspire.com</a>. Studio: {company.group.studio}.</p>
    </div>
  </section>

  <section class="section ground-dark" aria-labelledby="how-title">
    <div class="wrap">
      <p class="eyebrow">How we work</p>
      <h2 class="h2 fam-h" id="how-title">From enquiry to handover.</h2>
      <Process />
    </div>
  </section>

  <section class="section ground-paper" aria-labelledby="cred-title">
    <div class="wrap">
      <p class="eyebrow">Credentials</p>
      <h2 class="h2 fam-h" id="cred-title">Registration, insurance and standards.</h2>
      <Credentials />
    </div>
  </section>

  <CtaBand context="about" />
</Base>

<style>
  .about-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px clamp(40px, 7vw, 112px); align-items: start; }
  .prose h2:first-child { margin-top: 0; }
  .about-fig { margin: 0; display: grid; gap: 12px; position: sticky; top: calc(var(--header-h) + 24px); }
  .about-fig :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .about-fig figcaption { color: var(--ink-3); font-size: .75rem; margin-top: 6px; }
  .fam-h { margin: 16px 0 40px; }
  .family { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--rule-strong); }
  .family li { display: grid; gap: 12px; align-content: start; padding: 28px 28px 32px 0; border-bottom: 1px solid var(--rule); }
  .family li + li { padding-left: 28px; border-left: 1px solid var(--rule); }
  .family .mono { color: var(--brass-ink); font-size: .75rem; }
  .fam-name { font-family: var(--serif); font-size: 2rem; line-height: 1.05; }
  .fam-what { color: var(--ink-2); }
  .you .fam-name { color: var(--brass-ink); }
  .fam-note { margin-top: 24px; color: var(--ink-2); }
  .fam-note a { color: var(--brass-ink); }
  @media (max-width: 960px) {
    .about-grid, .family { grid-template-columns: 1fr; }
    .about-fig { position: static; }
    .family li + li { padding-left: 0; border-left: 0; }
  }
</style>
