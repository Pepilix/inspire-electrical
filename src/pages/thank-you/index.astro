---
import Base from '../../layouts/Base.astro';
import { href } from '../../lib/site';
---
<Base title="Thank you | Inspire Electrical" description="Thank you for your enquiry. Inspire Electrical will be in touch to talk about your electrical work." noindex>
  <section class="section ground-dark ty">
    <div class="wrap">
      <p class="eyebrow">Enquiry received</p>
      <h1 class="h1 ty-title">Thank you. We have your enquiry.</h1>
      <p class="lead">We will read it and come back to you, usually with a question or two and a suggested next step. If you have drawings or photographs you did not attach, have them ready.</p>
      <p class="ty-links"><a class="text-link" href={href('/advice/')}><span>Read our advice guides</span><span class="arrow" aria-hidden="true"></span></a><a class="text-link" href={href('/')}><span>Back to the homepage</span><span class="arrow" aria-hidden="true"></span></a></p>
    </div>
  </section>
</Base>
<style>
  .ty { min-height: 70vh; display: grid; align-items: center; }
  .ty-title { margin: 20px 0 24px; max-width: 14ch; }
  .ty-links { display: flex; gap: 32px; flex-wrap: wrap; margin-top: 36px; }
</style>
