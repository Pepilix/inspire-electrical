---
import { getCollection, getEntries, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { href, absolute } from '../../lib/site';
import { breadcrumbSchema, webPageSchema, businessRef } from '../../lib/schema';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft);
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const services = await getEntries(d.services);
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpg,jpeg,png,webp,avif}');
const images = (await Promise.all(d.images.map(async (i) => (photos[`/src/assets/${i.src}`] ? { img: (await photos[`/src/assets/${i.src}`]()).default, alt: i.alt } : null)))).filter(Boolean) as { img: ImageMetadata; alt: string }[];
const path = `/projects/${project.id}/`;
const crumbs = [{ label: 'Projects', path: '/projects/' }, { label: d.title, path }];
const schema = [
  webPageSchema(path, d.seoTitle, d.description, Astro.site),
  breadcrumbSchema(crumbs, Astro.site),
  { '@type': 'CreativeWork', name: d.title, description: d.description, creator: businessRef(Astro.site), locationCreated: { '@type': 'Place', name: d.location }, url: absolute(path, Astro.site) },
];
---
<Base title={d.seoTitle} description={d.description} schema={schema}>
  <PageHeader eyebrow={`Projects · ${d.type}`} title={d.title} lead={d.requirements} crumbs={crumbs}>
    <dl class="schedule">
      <div><dt>Location</dt><dd>{d.location}</dd></div>
      <div><dt>Type</dt><dd>{d.type}</dd></div>
      <div><dt>Completed</dt><dd>{d.completed.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</dd></div>
      {d.schedule.map((r) => <div><dt>{r.label}</dt><dd>{r.value}</dd></div>)}
    </dl>
  </PageHeader>

  {images[0] && <div class="hero-img"><Image src={images[0].img} alt={images[0].alt} widths={[800, 1400, 2000]} sizes="100vw" /></div>}

  <section class="section ground-paper">
    <div class="wrap proj-grid">
      <div class="prose">
        <h2>Scope of work</h2>
        <ul>{d.scope.map((s) => <li>{s}</li>)}</ul>
        <h2>Challenges</h2>
        <p>{d.challenges}</p>
        <h2>Solution</h2>
        <p>{d.solution}</p>
        <Content />
      </div>
      <aside>
        <p class="mono label">Services used</p>
        <ul role="list" class="svc">{services.map((s) => <li><a class="text-link" href={href(`/services/${s.id}/`)}><span>{s.data.navTitle}</span><span class="arrow" aria-hidden="true"></span></a></li>)}</ul>
      </aside>
    </div>
  </section>

  {images.length > 1 && (
    <section class="section--tight ground-paper">
      <div class="wrap gallery">
        {images.slice(1).map((i) => <div data-reveal="clip"><Image src={i.img} alt={i.alt} widths={[600, 1000]} sizes="(max-width: 860px) 100vw, 50vw" loading="lazy" /></div>)}
      </div>
    </section>
  )}

  <CtaBand context="project" />
</Base>

<style>
  .hero-img :global(img) { width: 100%; max-height: 80vh; object-fit: cover; }
  .proj-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 48px; }
  .label { color: var(--copper-ink); text-transform: uppercase; letter-spacing: .12em; font-size: .6875rem; margin-bottom: 12px; }
  .svc { display: grid; gap: 10px; }
  .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .gallery :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 860px) { .proj-grid, .gallery { grid-template-columns: 1fr; } }
</style>
