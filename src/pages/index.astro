---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { href, absolute } from '../lib/site';
import firstFix from '../assets/group/yarm-first-fix.jpg';
import cinema from '../assets/group/yarm-cinema.webp';
import stair from '../assets/group/cadogan-stair.jpg';
import rack from '../assets/group/yarm-rack.jpg';

const services = Object.fromEntries((await getCollection('services')).map((s) => [s.id, s.data.navTitle]));
const tiles = [
  { name: 'Homes', line: 'From an extra socket to a full rewire.', img: cinema, alt: 'A finished room with recessed lighting', links: ['house-rewiring', 'consumer-unit-upgrades', 'electrical-testing-eicr', 'lighting-installation'] },
  { name: 'New builds and renovations', line: 'Complete installations, planned with your architect and builder.', img: stair, alt: 'A staircase with LED step lights in a renovated townhouse', links: ['new-build-electrical-installation', 'electrical-design', 'outdoor-lighting'] },
  { name: 'Commercial', line: 'Fit-outs, lighting and maintenance for businesses.', img: rack, alt: 'Neatly labelled cable terminations', links: ['commercial-electrical', 'commercial-lighting', 'electrical-maintenance'] },
];
const locations = (await getCollection('locations')).sort((a, b) => a.data.order - b.data.order);

const schema = [{
  '@type': 'WebPage',
  '@id': absolute('/#webpage', Astro.site),
  url: absolute('/', Astro.site),
  name: 'Electrical Contractors Harrogate & York | Inspire Electrical',
  isPartOf: { '@id': absolute('/#website', Astro.site) },
  about: { '@id': absolute('/#business', Astro.site) },
  inLanguage: 'en-GB',
}];
---
<Base
  title="Electrical Contractors Harrogate & York | Inspire Electrical"
  description="Professional electrical installation, rewiring, lighting and testing across Harrogate, York, Wetherby and North Yorkshire. Contact Inspire Electrical."
  canonical="/"
  schema={schema}
>
  <section class="hero ground-dark" aria-labelledby="hero-title">
    <div class="hero-img" aria-hidden="true">
      <Image src={firstFix} alt="" widths={[640, 1000, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap hero-inner">
      <h1 id="hero-title" class="hero-title">Electrical installation, done properly.</h1>
      <p class="hero-text">For homes, businesses and new builds across Harrogate, York, Wetherby and North Yorkshire.</p>
      <div class="hero-actions">
        <a class="btn btn--light" href={href('/contact/')} data-track="cta_click" data-cta="hero">Discuss your project</a>
        <a class="btn" href={href('/services/')}>Our services</a>
      </div>
    </div>
  </section>

  <section class="section ground-white intro" aria-labelledby="intro-title">
    <div class="wrap intro-grid">
      <div>
        <p class="label"><b>Who</b><span>we are</span></p>
        <h2 class="h2 intro-title" id="intro-title">Part of Inspire, installing technology in homes since 2009.</h2>
      </div>
      <div class="intro-text">
        <p>Inspire Electrical is the electrical side of the Inspire group, alongside Inspire Audio Visual and Care Home WiFi.</p>
        <p>We take on everything from an extra socket or a new consumer unit to the complete installation for a new house, and we are just as happy working for a homeowner as alongside a builder or architect.</p>
        <a class="text-link" href={href('/about/')}><span>About us</span><span class="arrow" aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  <section class="section--tight ground-paper" aria-labelledby="services-title">
    <div class="wrap">
      <div class="services-head">
        <p class="label"><b>What</b><span>we install</span></p>
        <h2 class="visually-hidden" id="services-title">Services</h2>
      </div>
      <ul role="list" class="tiles">
        {tiles.map((t) => (
          <li class="tile">
            <div class="tile-img"><Image src={t.img} alt={t.alt} widths={[480, 800]} sizes="(max-width: 860px) 100vw, 33vw" loading="lazy" /></div>
            <h3 class="tile-name">{t.name}</h3>
            <p class="tile-line">{t.line}</p>
            <ul role="list" class="tile-links">
              {t.links.map((id) => <li><a href={href(`/services/${id}/`)}>{services[id]}</a></li>)}
            </ul>
          </li>
        ))}
      </ul>
      <p class="all"><a class="text-link" href={href('/services/')}><span>All services</span><span class="arrow" aria-hidden="true"></span></a></p>
    </div>
  </section>

  <section class="section--tight ground-white areas" aria-labelledby="areas-title">
    <div class="wrap areas-inner">
      <p class="label"><b>Where</b><span>we work</span></p>
      <p class="areas-text" id="areas-title">
        Working across
        {locations.map((l, i) => <>{i > 0 && (i === locations.length - 1 ? ' and ' : ', ')}<a href={href(`/areas/${l.id}/`)}>{l.data.town}</a></>)}
        and the <a href={href('/areas-we-cover/')}>surrounding area</a>.
      </p>
    </div>
  </section>

  <CtaBand context="home" />
</Base>

<style>
  .hero { position: relative; min-height: min(78svh, 760px); display: grid; align-items: end; overflow: hidden; isolation: isolate; }
  .hero-img { position: absolute; inset: 0; z-index: -1; }
  .hero-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero-img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(20, 18, 18, .88) 0%, rgba(20, 18, 18, .5) 55%, rgba(20, 18, 18, .3) 100%), linear-gradient(to right, rgba(20, 18, 18, .45), rgba(20, 18, 18, 0) 65%); }
  .hero-inner { width: 100%; padding-block: clamp(48px, 9vh, 96px); }
  .hero-title { font-family: var(--serif); font-weight: 500; font-size: clamp(2.75rem, 6.4vw, 5.75rem); line-height: 1; max-width: 12ch; text-wrap: balance; }
  .hero-text { margin-top: 20px; font-size: clamp(1.0625rem, 1.4vw, 1.25rem); max-width: 30em; color: var(--on-dark); opacity: .88; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  .intro-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 32px clamp(40px, 7vw, 112px); align-items: end; }
  .intro-title { margin-top: 28px; max-width: 16ch; }
  .intro-text p { color: var(--ink-2); }
  .intro-text p + p { margin-top: 1em; }
  .intro-text .text-link { margin-top: 24px; }

  .services-head { margin-bottom: 36px; }
  .tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); }
  .tile-img { aspect-ratio: 4 / 5; overflow: hidden; background: var(--paper-2); }
  .tile-img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .tile:hover .tile-img :global(img) { transform: scale(1.03); }
  .tile-name { margin-top: 22px; font-family: var(--serif); font-weight: 500; font-size: clamp(1.75rem, 2.6vw, 2.25rem); line-height: 1.05; }
  .tile-line { margin-top: 8px; color: var(--ink-2); }
  .tile-links { margin-top: 14px; display: grid; gap: 6px; }
  .tile-links a { color: var(--ink); text-underline-offset: 4px; text-decoration-color: var(--rule); }
  .tile-links a:hover { text-decoration-color: currentColor; }
  .all { margin-top: 40px; }

  .areas-inner { display: grid; gap: 22px; }
  .areas-text { font-family: var(--serif); font-size: clamp(1.625rem, 3vw, 2.5rem); line-height: 1.25; max-width: 30ch; }
  .areas-text a { text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .areas-text a:hover { color: var(--brass-ink); }

  @media (max-width: 860px) {
    .intro-grid, .tiles { grid-template-columns: 1fr; }
    .tile-img { aspect-ratio: 3 / 2; }
    .hero { min-height: 72svh; }
  }
</style>
