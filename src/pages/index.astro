---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gateway from '../components/Gateway.astro';
import CoverageMap from '../components/CoverageMap.astro';
import Process from '../components/Process.astro';
import Faqs from '../components/Faqs.astro';
import CtaBand from '../components/CtaBand.astro';
import Verify from '../components/Verify.astro';
import { company } from '../data/company';
import { href, absolute } from '../lib/site';
import firstFix from '../assets/group/yarm-first-fix.jpg';
import cinema from '../assets/group/yarm-cinema.webp';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { id: 'homes', title: 'For homes', items: services.filter((s) => s.data.group === 'domestic') },
  { id: 'projects', title: 'Projects and commercial', items: services.filter((s) => s.data.group === 'projects') },
];
const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order).map((f) => f.data);

const schema = [
  {
    '@type': 'WebPage',
    '@id': absolute('/#webpage', Astro.site),
    url: absolute('/', Astro.site),
    name: 'Electrical Contractors Harrogate & York | Inspire Electrical',
    isPartOf: { '@id': absolute('/#website', Astro.site) },
    about: { '@id': absolute('/#business', Astro.site) },
    inLanguage: 'en-GB',
  },
];
---
<Base
  title="Electrical Contractors Harrogate & York | Inspire Electrical"
  description="Professional electrical installation, rewiring, lighting and testing across Harrogate, York, Wetherby and North Yorkshire. Contact Inspire Electrical."
  canonical="/"
  schema={schema}
>
  <Gateway />

  <!-- About: the story, the same before/after pair used on trustinspire.com, and a title block -->
  <section class="section ground-paper about" id="about" aria-labelledby="about-title">
    <div class="wrap about-grid">
      <div>
        <h2 id="about-title" class="statement" data-reveal>Small jobs and whole houses, by the people who have wired demanding homes since 2009.</h2>
        <div class="about-text" data-reveal>
          <p>Inspire started out wiring and programming smart homes. That work only succeeds when the electrical installation underneath it is right: the cable routes, the consumer unit, the lighting circuits and the paperwork.</p>
          <p>Inspire Electrical is the group's electrical contracting business. We take on everything from an extra socket or a consumer unit change to the complete installation for a new house, and we work alongside builders, architects and the rest of the Inspire team.</p>
        </div>
        <dl class="title-block" data-reveal>
          <div><dt>Practice</dt><dd>Inspire Electrical</dd></div>
          <div><dt>Part of</dt><dd><a href={company.group.url}>Inspire</a>, est. {company.group.since}</dd></div>
          <div><dt>Studio</dt><dd>{company.group.studio}</dd></div>
          <div><dt>Working across</dt><dd>Harrogate, York, Wetherby</dd></div>
          <div><dt>Registration</dt><dd>{company.competentPersonScheme ? company.competentPersonScheme.name : <Verify label="Scheme" />}</dd></div>
          <div><dt>Certification</dt><dd>Every job, to BS 7671</dd></div>
        </dl>
      </div>
      <figure class="layers">
        <div class="layer layer--back" data-reveal="clip">
          <Image src={firstFix} alt="A room at first fix: open roof trusses, block walls and new stud framing" widths={[480, 800, 1200]} sizes="(max-width: 860px) 82vw, 34vw" loading="lazy" data-parallax="-0.04" />
        </div>
        <div class="layer layer--front" data-reveal="clip">
          <Image src={cinema} alt="The same room finished, with recessed lighting and a projection screen" widths={[400, 700, 1000]} sizes="(max-width: 860px) 70vw, 28vw" loading="lazy" data-parallax="0.05" />
        </div>
        <figcaption><span class="dim" aria-hidden="true"></span>An Inspire room in Yarm, at first fix and at handover.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Services -->
  <section class="section ground-dark" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="head">
        <h2 id="services-title" class="h2">Services</h2>
        <p>Domestic work and project work, done to the same standard.</p>
      </div>
      <div class="svc-cols">
        {groups.map((g) => (
          <div class="svc-col" data-reveal>
            <p class="eyebrow svc-col-label">{g.title}</p>
            <ul role="list" class="svc-list">
              {g.items.map((s) => (
                <li>
                  <a href={href(`/services/${s.id}/`)}>
                    <span class="svc-name">{s.data.navTitle}</span>
                    <span class="svc-sum">{s.data.summary}</span>
                    <span class="arrow" aria-hidden="true"></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Where we work -->
  <section class="section ground-paper" aria-labelledby="areas-title">
    <div class="wrap">
      <div class="head head--paper">
        <h2 id="areas-title" class="h2">Where we work</h2>
        <p>Harrogate, York, Wetherby and the towns and villages between them.</p>
      </div>
      <div class="areas-map"><CoverageMap /></div>
    </div>
  </section>

  <!-- How a job runs -->
  <section class="section ground-dark" aria-labelledby="approach-title">
    <div class="wrap">
      <div class="head">
        <h2 id="approach-title" class="h2">How a job runs</h2>
        <p>The same five steps for a socket or a new house.</p>
      </div>
      <div class="process-wrap"><Process /></div>
    </div>
  </section>

  <section class="section ground-paper">
    <div class="wrap"><Faqs items={faqs} /></div>
  </section>

  <CtaBand context="home" />
</Base>

<style>
  .head {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 16px 48px; flex-wrap: wrap;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--rule-dark);
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .head p { color: var(--on-dark-2); max-width: 30em; }
  .head--paper { border-bottom-color: var(--rule); }
  .head--paper p { color: var(--ink-2); }

  /* About: as on trustinspire.com */
  .about-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 56px clamp(40px, 7vw, 112px); align-items: start; }
  .statement { font-family: var(--serif); font-weight: 500; font-size: clamp(1.875rem, 3.4vw, 3rem); line-height: 1.1; max-width: 20ch; text-wrap: balance; }
  .about-text { margin-top: clamp(28px, 3vw, 40px); max-width: 36em; }
  .about-text p { line-height: 1.65; color: var(--ink-2); }
  .about-text p + p { margin-top: 1em; }
  .title-block { display: grid; grid-template-columns: 1fr 1fr; margin-top: clamp(36px, 4vw, 56px); border: 1px solid var(--ink); max-width: 560px; }
  .title-block > div { padding: 12px 14px; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .title-block > div:nth-child(2n) { border-right: 0; }
  .title-block > div:nth-last-child(-n+2) { border-bottom: 0; }
  .title-block dt { font-family: var(--mono); font-size: .6875rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: .06em; }
  .title-block dd { font-weight: 500; margin-top: 2px; }
  .title-block a { text-underline-offset: 3px; }

  .layers { position: relative; margin: 0; padding-bottom: 72px; }
  .layer { overflow: hidden; }
  .layer :global(img) { width: 100%; height: 112%; margin-top: -6%; object-fit: cover; }
  .layer--back { width: 82%; aspect-ratio: 4 / 3; }
  .layer--back :global(img) { filter: grayscale(.25); }
  .layer--front { position: relative; width: 70%; aspect-ratio: 4 / 3; margin: -34% 0 0 auto; outline: 10px solid var(--paper); }
  .layers figcaption { display: flex; align-items: center; gap: 14px; margin-top: 20px; font-size: .875rem; color: var(--ink-2); }
  .dim { position: relative; flex: 0 0 56px; height: 1px; background: var(--brass); }
  .dim::before, .dim::after { content: ''; position: absolute; top: -4px; width: 1px; height: 9px; background: var(--brass); }
  .dim::before { left: 0; } .dim::after { right: 0; }

  /* Services: two plain lists, like the trustinspire contact list */
  .svc-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 40px clamp(40px, 6vw, 96px); }
  .svc-col-label { margin-bottom: 14px; }
  .svc-list { border-top: 1px solid var(--on-dark-2); }
  .svc-list a {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 4px 16px;
    padding-block: 18px;
    border-bottom: 1px solid var(--rule-dark);
    text-decoration: none;
  }
  .svc-name { font-family: var(--serif); font-weight: 500; font-size: clamp(1.375rem, 2vw, 1.75rem); line-height: 1.15; }
  .svc-sum { grid-column: 1; color: var(--on-dark-2); font-size: .875rem; }
  .svc-list .arrow { grid-column: 2; grid-row: 1 / span 2; color: var(--brass); }
  .svc-list a:hover .svc-name { color: var(--brass); }

  .areas-map { max-width: 1100px; }
  .process-wrap { margin-top: 12px; }

  @media (max-width: 860px) {
    .about-grid, .svc-cols { grid-template-columns: 1fr; }
    .layers { padding-bottom: 0; }
  }
  @media (max-width: 420px) {
    .title-block { grid-template-columns: 1fr; }
    .title-block > div { border-right: 0; }
    .title-block > div:nth-last-child(2) { border-bottom: 1px solid var(--rule); }
  }
</style>
