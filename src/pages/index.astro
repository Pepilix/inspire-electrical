---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServiceExplorer from '../components/ServiceExplorer.astro';
import CoverageMap from '../components/CoverageMap.astro';
import Process from '../components/Process.astro';
import Credentials from '../components/Credentials.astro';
import Faqs from '../components/Faqs.astro';
import CtaBand from '../components/CtaBand.astro';
import { company } from '../data/company';
import { href, absolute } from '../lib/site';
import firstFix from '../assets/group/yarm-first-fix.jpg';
import cinema from '../assets/group/yarm-cinema.webp';
import stair from '../assets/group/cadogan-stair.jpg';
import rack from '../assets/group/yarm-rack.jpg';

const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order).map((f) => f.data);
const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => +b.data.completed - +a.data.completed).slice(0, 3);

const reasons = [
  { t: 'Designed before it is installed', d: 'Layouts, circuits and lighting are worked out on paper first, so you know what you are getting and the installation is right first time.' },
  { t: 'Coordinated with everyone else on site', d: 'Builders, kitchen fitters, plumbers, joiners and AV installers all depend on the electrics. We agree positions and timings with them, not around them.' },
  { t: 'Lighting understood properly', d: 'Layered schemes, concealed LED, dimming that does not flicker and lighting control that is wired correctly from first fix.' },
  { t: 'Technology-ready', d: 'Part of the same group as Inspire Audio Visual, so data, AV, control and EV provision are planned in, not added later.' },
  { t: 'Paperwork you can rely on', d: 'Certificates for every job, notifiable work registered, circuits labelled and records handed over.' },
  { t: 'Small jobs done just as carefully', d: 'One extra socket gets the same checks and testing as a new house. There is no minimum size of job.' },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': absolute('/#webpage', Astro.site),
    url: absolute('/', Astro.site),
    name: 'Electrical Contractors Harrogate & York | Inspire Electrical',
    isPartOf: { '@id': absolute('/#website', Astro.site) },
    about: { '@id': absolute('/#business', Astro.site) },
    inLanguage: 'en-GB',
  },
];
---
<Base
  title="Electrical Contractors Harrogate & York | Inspire Electrical"
  description="Professional electrical installation, rewiring, lighting and testing across Harrogate, York, Wetherby and North Yorkshire. Contact Inspire Electrical."
  canonical="/"
  schema={schema}
>
  <Hero />

  <div class="circuit" data-circuit>
    <span class="circuit-line" aria-hidden="true"><span class="circuit-fill"></span></span>

    <!-- 2. Introduction -->
    <section class="section ground-paper intro" aria-labelledby="intro-title">
      <div class="wrap intro-grid">
        <div class="intro-copy">
          <span class="c-node" data-circuit-node aria-hidden="true"></span>
          <p class="eyebrow">01 · Inspire Electrical</p>
          <h2 class="h2 intro-title" id="intro-title" data-reveal>Electrical work that is thought through before the first cable is pulled.</h2>
          <div class="intro-text" data-reveal data-reveal-delay="1">
            <p class="lead">Inspire Electrical installs, designs, tests and maintains electrical systems for homes, businesses and developments across North Yorkshire.</p>
            <p>The same standard applies whether you need an extra socket in the kitchen or the complete installation for a new house: check what is there, plan it properly, install it neatly, test it and leave the paperwork in order.</p>
            <p>Inspire Electrical is part of <a href={company.group.url}>Inspire</a>, the group behind <a href="https://www.inspire-av.com/">Inspire Audio Visual</a>, which has designed and installed smart home, lighting and cinema systems in demanding homes since {company.group.since}. Inspire Electrical is the group's newest business, bringing electrical contracting alongside that technology work.</p>
          </div>
          <a class="text-link intro-link" href={href('/about/')}><span>About Inspire Electrical</span><span class="arrow" aria-hidden="true"></span></a>
        </div>
        <figure class="intro-figure">
          <div class="intro-back" data-reveal="clip">
            <Image src={firstFix} alt="A room at first fix, with open roof trusses, block walls and new stud framing" widths={[480, 800, 1200]} sizes="(max-width: 860px) 90vw, 36vw" loading="lazy" data-parallax="-0.04" />
          </div>
          <div class="intro-front" data-reveal="clip" data-reveal-delay="2">
            <Image src={cinema} alt="The same room finished as a home cinema with recessed lighting" widths={[400, 700, 1000]} sizes="(max-width: 860px) 70vw, 28vw" loading="lazy" data-parallax="0.05" />
          </div>
          <figcaption class="mono"><span class="dim" aria-hidden="true"></span>Inspire Audio Visual project, Yarm: first fix and handover. Shown as group work, not an Inspire Electrical project.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 3. Services -->
    <section class="section ground-dark" id="services" aria-labelledby="services-title">
      <div class="wrap">
        <div class="section-head">
          <span class="c-node" data-circuit-node aria-hidden="true"></span>
          <p class="eyebrow">02 · Services</p>
          <h2 class="h2" id="services-title" data-reveal>From a single socket to a complete installation.</h2>
          <p class="lead" data-reveal data-reveal-delay="1">Two kinds of client, one standard. Choose a service to see what is involved.</p>
        </div>
        <ServiceExplorer />
        <p class="all-services"><a class="text-link" href={href('/services/')}><span>All services</span><span class="arrow" aria-hidden="true"></span></a></p>
      </div>
    </section>

    <!-- 4. Why Inspire Electrical -->
    <section class="section ground-paper" aria-labelledby="why-title">
      <div class="wrap">
        <div class="section-head section-head--split">
          <span class="c-node" data-circuit-node aria-hidden="true"></span>
          <div>
            <p class="eyebrow">03 · Why Inspire Electrical</p>
            <h2 class="h2" id="why-title" data-reveal>Approachable enough for a socket. Thorough enough for an architect.</h2>
          </div>
        </div>
        <ol class="reasons" role="list">
          {reasons.map((r, i) => (
            <li class="reason" data-reveal data-reveal-delay={String(i % 3)}>
              <span class="reason-n mono">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="reason-title">{r.t}</h3>
              <p>{r.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5. Projects -->
    <section class="section ground-dark" aria-labelledby="projects-title">
      <div class="wrap">
        <div class="section-head section-head--split">
          <span class="c-node" data-circuit-node aria-hidden="true"></span>
          <div>
            <p class="eyebrow">04 · Projects</p>
            <h2 class="h2" id="projects-title" data-reveal>{projects.length ? 'Recent projects' : 'Project work'}</h2>
          </div>
          <p class="lead" data-reveal data-reveal-delay="1">
            {projects.length
              ? 'A selection of recent work, with the scope, challenges and solution for each.'
              : 'Inspire Electrical’s own case studies will be published here as projects complete. Until then, this is lighting and infrastructure work from the wider Inspire group, carried out by Inspire Audio Visual.'}
          </p>
        </div>

        {projects.length > 0 ? (
          <ul role="list" class="proj-grid">
            {projects.map((p) => (
              <li><a href={href(`/projects/${p.id}/`)} class="proj-card"><span class="mono">{p.data.type} · {p.data.location}</span><span class="h3">{p.data.title}</span><span class="arrow" aria-hidden="true"></span></a></li>
            ))}
          </ul>
        ) : (
          <div class="group-work">
            <article class="gw gw--a">
              <div class="gw-media" data-reveal="clip"><Image src={stair} alt="Staircase at Cadogan Place with LED step lights and a parquet hallway" widths={[400, 700, 1000]} sizes="(max-width: 860px) 90vw, 30vw" loading="lazy" data-parallax="0.05" /></div>
              <div class="gw-info" data-reveal>
                <p class="mono gw-kind">Group work · Inspire Audio Visual</p>
                <h3 class="h3">Cadogan Place, Belgravia</h3>
                <p>Lutron lighting and Sonos audio retrofitted into a Georgian townhouse during its renovation.</p>
                <dl class="schedule">
                  <div><dt>Lighting</dt><dd>Lutron, whole-home scenes</dd></div>
                  <div><dt>Audio</dt><dd>Four Sonos zones</dd></div>
                </dl>
                <a class="text-link" href="https://www.inspire-av.com/project/london-lutron-and-sonos-installation/"><span>Case study on inspire-av.com</span><span class="arrow" aria-hidden="true"></span></a>
              </div>
            </article>
            <article class="gw gw--b">
              <div class="gw-media" data-reveal="clip"><Image src={rack} alt="Equipment rack with labelled speaker connections" widths={[400, 700, 1000]} sizes="(max-width: 860px) 90vw, 30vw" loading="lazy" data-parallax="0.05" /></div>
              <div class="gw-info" data-reveal>
                <p class="mono gw-kind">Group work · Inspire Audio Visual</p>
                <h3 class="h3">Home cinema, Yarm</h3>
                <p>A cinema in a purpose-built room in a new-build home, from first fix cabling to commissioning.</p>
                <dl class="schedule">
                  <div><dt>Audio</dt><dd>7.2.4 Dolby Atmos</dd></div>
                  <div><dt>Control</dt><dd>Control4</dd></div>
                </dl>
                <a class="text-link" href="https://www.inspire-av.com/project/yarm-home-cinema/"><span>Case study on inspire-av.com</span><span class="arrow" aria-hidden="true"></span></a>
              </div>
            </article>
          </div>
        )}
        <p class="all-services"><a class="text-link" href={href('/projects/')}><span>Projects</span><span class="arrow" aria-hidden="true"></span></a></p>
      </div>
    </section>

    <!-- 6. Where we work -->
    <section class="section ground-paper" aria-labelledby="areas-title">
      <div class="wrap">
        <div class="section-head section-head--split">
          <span class="c-node" data-circuit-node aria-hidden="true"></span>
          <div>
            <p class="eyebrow">05 · Where we work</p>
            <h2 class="h2" id="areas-title" data-reveal>Harrogate, York, Wetherby and the country between.</h2>
          </div>
          <p class="lead" data-reveal data-reveal-delay="1">We work across the triangle between the three towns and out to Ripon, Thirsk and Tadcaster. Select a town for local information.</p>
        </div>
        <CoverageMap />
      </div>
    </section>

    <!-- 7. Approach -->
    <section class="section ground-dark" aria-labelledby="approach-title">
      <div class="wrap">
        <div class="section-head">
          <span class="c-node" data-circuit-node aria-hidden="true"></span>
          <p class="eyebrow">06 · How it works</p>
          <h2 class="h2" id="approach-title" data-reveal>Five steps, whatever the size of the job.</h2>
        </div>
        <Process />
      </div>
    </section>

    <!-- 8. Credentials -->
    <section class="section ground-paper" aria-labelledby="cred-title">
      <div class="wrap">
        <div class="section-head section-head--split">
          <span class="c-node" data-circuit-node aria-hidden="true"></span>
          <div>
            <p class="eyebrow">07 · Credentials</p>
            <h2 class="h2" id="cred-title" data-reveal>Standards, registration and insurance.</h2>
          </div>
          <p class="lead" data-reveal data-reveal-delay="1">What you should expect from any electrician you employ, and how we meet it.</p>
        </div>
        <Credentials />
      </div>
    </section>

    <!-- 9. FAQs -->
    <section class="section ground-white">
      <div class="wrap">
        <span class="c-node c-node--faq" data-circuit-node aria-hidden="true"></span>
        <Faqs items={faqs} />
      </div>
    </section>
  </div>

  <!-- 10. Final CTA -->
  <CtaBand context="home" />
</Base>

<style>
  /* Circuit line: a copper single-line diagram running down the page (wide screens) */
  .circuit { position: relative; }
  .circuit-line { position: absolute; top: 0; bottom: 0; z-index: 2; width: 1px; left: calc(max(0px, (100% - var(--wrap)) / 2) + var(--gutter) / 2); background: rgba(154, 79, 40, .25); pointer-events: none; }
  .circuit-fill { position: absolute; inset: 0; background: var(--copper); transform-origin: top; transform: scaleY(var(--progress, 0)); }
  .c-node { position: absolute; left: calc(var(--gutter) / -2 - 4.5px); top: 4px; z-index: 3; width: 10px; height: 10px; border: 1px solid var(--copper); border-radius: 50%; background: var(--paper); transition: background .4s var(--ease), box-shadow .4s; }
  .ground-dark .c-node { background: var(--charcoal); }
  :global(.c-node.is-live) { background: var(--copper) !important; box-shadow: 0 0 0 4px rgba(200, 129, 79, .18); }
  .c-node--faq { position: relative; display: block; left: calc(var(--gutter) / -2 - 4.5px); top: 0; margin-bottom: -10px; }
  :global(html:not(.js)) .circuit-fill { transform: none; }
  @media (max-width: 1199px) { .circuit-line, .c-node { display: none; } }

  .section-head { position: relative; display: grid; gap: 20px; max-width: 880px; margin-bottom: clamp(40px, 6vw, 72px); }
  .section-head--split { max-width: none; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; gap: 20px clamp(32px, 6vw, 96px); }
  .section-head .h2 { margin-top: 18px; }
  .section-head--split .lead { padding-bottom: 6px; }
  .all-services { margin-top: clamp(40px, 5vw, 64px); }

  /* Intro */
  .intro-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 56px clamp(40px, 7vw, 112px); align-items: center; }
  .intro-copy { position: relative; }
  .intro-title { margin-top: 18px; }
  .intro-text { margin-top: 32px; max-width: 36em; }
  .intro-text p + p { margin-top: 1em; color: var(--ink-2); }
  .intro-text a { color: var(--copper-ink); text-underline-offset: 3px; }
  .intro-link { margin-top: 28px; }
  .intro-figure { position: relative; margin: 0; padding-bottom: 20px; }
  .intro-back, .intro-front { overflow: hidden; }
  .intro-back { width: 84%; aspect-ratio: 4 / 3; }
  .intro-front { position: relative; width: 66%; aspect-ratio: 4 / 3; margin: -32% 0 0 auto; outline: 10px solid var(--paper); }
  .intro-back :global(img), .intro-front :global(img) { width: 100%; height: 112%; margin-top: -6%; object-fit: cover; }
  .intro-back :global(img) { filter: grayscale(.3); }
  .intro-figure figcaption { display: flex; gap: 14px; align-items: center; margin-top: 20px; font-size: .75rem; color: var(--ink-3); }
  .dim { position: relative; flex: 0 0 48px; height: 1px; background: var(--copper-ink); }
  .dim::before, .dim::after { content: ''; position: absolute; top: -4px; width: 1px; height: 9px; background: var(--copper-ink); }
  .dim::before { left: 0; } .dim::after { right: 0; }

  /* Reasons: a numbered schedule rather than cards */
  .reasons { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--rule-strong); }
  .reason { padding: 28px 28px 36px 0; border-bottom: 1px solid var(--rule); position: relative; }
  .reason:not(:nth-child(3n + 1)) { padding-left: 28px; border-left: 1px solid var(--rule); }
  .reason-n { color: var(--copper-ink); font-size: .75rem; }
  .reason-title { margin-top: 14px; font-family: var(--serif); font-weight: 600; font-size: 1.75rem; line-height: 1.1; }
  .reason p { margin-top: 12px; color: var(--ink-2); }
  .reason::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--copper-ink); transform: scaleX(0); transform-origin: left; transition: transform .7s var(--ease-out); }
  .reason:hover::after { transform: scaleX(1); }

  /* Group work */
  .group-work { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 80px); }
  .gw { display: grid; gap: 28px; }
  .gw--b { margin-top: clamp(0px, 10vw, 140px); }
  .gw-media { overflow: hidden; aspect-ratio: 4 / 5; background: var(--charcoal-2); }
  .gw-media :global(img) { width: 100%; height: 112%; margin-top: -6%; object-fit: cover; }
  .gw-kind { color: var(--copper); font-size: .75rem; }
  .gw-info .h3 { margin-top: 10px; }
  .gw-info > p:not(.gw-kind) { margin-top: 12px; color: var(--on-dark-2); }
  .gw-info .schedule { margin-top: 20px; }
  .gw-info .text-link { margin-top: 20px; }
  .proj-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .proj-card { display: grid; gap: 10px; padding: 24px; border: 1px solid var(--rule-dark); text-decoration: none; min-height: 220px; align-content: end; }

  @media (max-width: 960px) {
    .intro-grid, .section-head--split, .group-work { grid-template-columns: 1fr; }
    .gw--b { margin-top: 0; }
    .reasons { grid-template-columns: 1fr 1fr; }
    .reason:not(:nth-child(3n + 1)) { padding-left: 0; border-left: 0; }
    .reason:nth-child(even) { padding-left: 24px; border-left: 1px solid var(--rule); }
  }
  @media (max-width: 600px) {
    .reasons { grid-template-columns: 1fr; }
    .reason:nth-child(even) { padding-left: 0; border-left: 0; }
    .reason { padding-right: 0; }
  }
</style>
