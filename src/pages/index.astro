---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { company } from '../data/company';
import { towns } from '../data/areas';
import { href, absolute } from '../lib/site';
import firstFix from '../assets/group/yarm-first-fix.jpg';
import cinema from '../assets/group/yarm-cinema.webp';

// Customer wording first: these are the phrases people search for, each linking to the page that answers it.
const pathways = [
  {
    id: 'domestic', title: 'Domestic', who: 'For homeowners and landlords',
    items: [
      ['Extra sockets and switches', 'domestic-electrical'],
      ['Fuse box and consumer unit upgrades', 'consumer-unit-upgrades'],
      ['House rewiring', 'house-rewiring'],
      ['Electrical testing and EICRs', 'electrical-testing-eicr'],
      ['Indoor lighting', 'lighting-installation'],
      ['Outdoor and garden lighting', 'outdoor-lighting'],
      ['Fault finding', 'electrical-fault-finding'],
    ],
  },
  {
    id: 'projects', title: 'New builds and renovations', who: 'For homeowners, builders, architects and developers',
    items: [
      ['Extensions and renovations', 'new-build-electrical-installation'],
      ['New-build homes', 'new-build-electrical-installation'],
      ['Kitchens and bathrooms', 'domestic-electrical'],
      ['Electrical design from drawings', 'electrical-design'],
      ['Lighting design and control', 'lighting-installation'],
    ],
  },
  {
    id: 'commercial', title: 'Commercial', who: 'For businesses and property owners',
    items: [
      ['Commercial installations and fit-outs', 'commercial-electrical'],
      ['Commercial and emergency lighting', 'commercial-lighting'],
      ['Testing and inspection', 'electrical-testing-eicr'],
      ['Planned maintenance', 'electrical-maintenance'],
    ],
  },
];

const reasons = [
  { t: 'Small jobs are welcome', d: 'One extra socket gets the same care as a full installation. There is no minimum job size.' },
  { t: 'Clear written quotes', d: 'You know what is included before any work starts. Photographs or drawings help us quote accurately.' },
  { t: 'Certified, every time', d: 'Every job is tested and certified, and notifiable work is registered with building control.' },
  { t: 'Used to working with other trades', d: 'We work from architects’ drawings and alongside builders, kitchen fitters and plumbers on site.' },
];

const townLink = (t: (typeof towns)[number]) => href(t.priority ? `/areas/${t.id}/` : `/areas-we-cover/#${t.id}`);

const schema = [{
  '@type': 'WebPage',
  '@id': absolute('/#webpage', Astro.site),
  url: absolute('/', Astro.site),
  name: 'Electrical Contractors Harrogate & York | Inspire Electrical',
  isPartOf: { '@id': absolute('/#website', Astro.site) },
  about: { '@id': absolute('/#business', Astro.site) },
  inLanguage: 'en-GB',
}];
---
<Base
  title="Electrical Contractors Harrogate & York | Inspire Electrical"
  description="Professional electrical installation, rewiring, lighting and testing across Harrogate, York, Wetherby and North Yorkshire. Contact Inspire Electrical."
  canonical="/"
  schema={schema}
>
  <section class="hero ground-dark" aria-labelledby="hero-title">
    <div class="hero-img" aria-hidden="true">
      <Image src={firstFix} alt="" widths={[480, 800, 1200, 1600]} sizes="100vw" quality={60} loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap hero-inner">
      <h1 id="hero-title" class="hero-title">Electrical installation, done properly.</h1>
      <p class="hero-text">Electrical installation, testing and maintenance for homes, renovations and businesses in Harrogate, York, Wetherby and across North Yorkshire.</p>
      <div class="hero-actions">
        <a class="btn btn--light" href={href('/contact/')} data-track="cta_click" data-cta="hero_quote">Get a quote</a>
        <a class="btn" href="#services">Explore our services</a>
      </div>
    </div>
  </section>

  <!-- What we do and who we help -->
  <section class="section ground-white" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="label"><b>What</b><span>we do</span></p>
        <h2 class="h2" id="services-title">Electrical work for homes, projects and businesses</h2>
      </div>
      <div class="paths">
        {pathways.map((p) => (
          <section class="path" aria-labelledby={`path-${p.id}`}>
            <h3 class="path-title" id={`path-${p.id}`}>{p.title}</h3>
            <p class="path-who">{p.who}</p>
            <ul role="list" class="path-list">
              {p.items.map(([label, id]) => (
                <li><a href={href(`/services/${id}/`)}><span>{label}</span><span class="arrow" aria-hidden="true"></span></a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p class="paths-foot">Not sure which you need? <a href={href('/contact/')}>Describe the job</a> and we will tell you.</p>
    </div>
  </section>

  <!-- Why choose us, with the before-and-after as evidence -->
  <section class="section ground-paper" aria-labelledby="why-title">
    <div class="wrap why-grid">
      <div>
        <p class="label"><b>Why</b><span>choose us</span></p>
        <h2 class="h2 why-title" id="why-title">A new electrical business with an experienced team behind it</h2>
        <p class="why-intro">Inspire Electrical is the newest part of the <a href={company.group.url}>Inspire group</a>. Its sister business, <a href="https://www.inspire-av.com/">Inspire Audio Visual</a>, has installed lighting, cabling and smart home systems in demanding homes since {company.group.since}. That experience now goes into everyday electrical work too.</p>
        <ul role="list" class="reasons">
          {reasons.map((r) => (
            <li><h3>{r.t}</h3><p>{r.d}</p></li>
          ))}
        </ul>
      </div>
      <div class="why-evidence">
        <BeforeAfter
          before={firstFix}
          beforeAlt="A room at first fix: roof trusses, block walls, stud framing and cabling"
          after={cinema}
          afterAlt="The same room finished, with recessed lighting and a projection screen"
          caption="Drag to compare. One room in Yarm at first fix and at handover, an Inspire Audio Visual project."
        />
        <a class="text-link" href={href('/projects/')}><span>Projects</span><span class="arrow" aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  <!-- Where we work -->
  <section class="section--tight ground-white" aria-labelledby="areas-title">
    <div class="wrap areas">
      <div>
        <p class="label"><b>Where</b><span>we work</span></p>
        <h2 class="h3 areas-title" id="areas-title">North Yorkshire and the Wetherby area</h2>
      </div>
      <ul role="list" class="towns">
        {towns.map((t) => <li><a href={townLink(t)} class:list={{ main: t.priority }}>{t.name}</a></li>)}
        <li><a href={href('/areas-we-cover/')}>All areas</a></li>
      </ul>
    </div>
  </section>

  <CtaBand context="home" title="Planning electrical work? Let’s talk." text="Tell us what you need, from one extra socket to a full installation, and we will come back to you with a quote or a few questions." />
</Base>

<style>
  .hero { position: relative; min-height: min(72svh, 680px); display: grid; align-items: end; overflow: hidden; isolation: isolate; }
  .hero-img { position: absolute; inset: 0; z-index: -1; }
  .hero-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero-img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(20, 18, 18, .88) 0%, rgba(20, 18, 18, .5) 55%, rgba(20, 18, 18, .3) 100%), linear-gradient(to right, rgba(20, 18, 18, .5), rgba(20, 18, 18, 0) 65%); }
  .hero-inner { width: 100%; padding-block: clamp(40px, 8vh, 80px); }
  .hero-title { font-family: var(--serif); font-weight: 500; font-size: clamp(2.5rem, 5.2vw, 4.5rem); line-height: 1.02; max-width: 13ch; }
  .hero-text { margin-top: 18px; font-size: clamp(1.0625rem, 1.3vw, 1.1875rem); max-width: 34em; color: var(--on-dark); opacity: .9; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  .sec-head { display: grid; gap: 18px; margin-bottom: 36px; }

  .paths { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .path { padding: 26px 26px 18px; background: var(--paper); border-top: 3px solid var(--ink); }
  .path-title { font-family: var(--serif); font-weight: 600; font-size: 1.75rem; line-height: 1.1; }
  .path-who { margin-top: 6px; color: var(--ink-3); font-size: .875rem; }
  .path-list { margin-top: 16px; }
  .path-list a { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 11px 0; border-top: 1px solid var(--rule); text-decoration: none; font-weight: 500; }
  .path-list .arrow { width: 18px; color: var(--brass-ink); }
  .path-list a:hover { color: var(--brass-ink); }
  .path-list a:hover .arrow { width: 26px; }
  .paths-foot { margin-top: 24px; color: var(--ink-2); }
  .paths-foot a { color: var(--ink); font-weight: 500; text-underline-offset: 4px; }

  .why-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 40px clamp(40px, 6vw, 88px); align-items: start; }
  .why-title { margin-top: 18px; max-width: 18ch; }
  .why-intro { margin-top: 16px; color: var(--ink-2); max-width: 38em; }
  .why-intro a { color: var(--ink); text-underline-offset: 3px; }
  .reasons { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 32px; margin-top: 30px; }
  .reasons h3 { font-size: 1.0625rem; font-weight: 600; padding-top: 12px; border-top: 2px solid var(--brass); }
  .reasons p { margin-top: 6px; color: var(--ink-2); font-size: .9375rem; }
  .why-evidence .text-link { margin-top: 18px; }

  .areas { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 20px 48px; align-items: end; }
  .areas-title { margin-top: 16px; }
  .towns { display: flex; flex-wrap: wrap; gap: 8px; }
  .towns a { display: inline-block; padding: 9px 14px; border: 1px solid var(--rule); text-decoration: none; font-weight: 500; font-size: .9375rem; }
  .towns a.main { border-color: var(--ink); }
  .towns a:hover { background: var(--ink); color: var(--white); border-color: var(--ink); }

  @media (max-width: 960px) {
    .paths, .why-grid, .areas { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .hero { min-height: 64svh; }
    .reasons { grid-template-columns: 1fr; }
    .path { padding: 22px 18px 12px; }
  }
</style>
