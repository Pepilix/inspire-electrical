---
import '../styles/global.css';
import Seo, { type SeoProps } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Consent from '../components/Consent.astro';
import { href } from '../lib/site';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import cormorant500 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';

type Props = SeoProps & { bodyClass?: string };
const { bodyClass, ...seo } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#ffffff">
  <meta name="format-detection" content="telephone=no">
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml">
  <link rel="icon" href={href('/favicon-32.png')} sizes="32x32" type="image/png">
  <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={cormorant500} as="font" type="font/woff2" crossorigin>
  <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')}>
  <Seo {...seo} />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <slot name="head" />
</head>
<body class={bodyClass}>
  <Consent />
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <MobileBar />
  <script>
    import '../scripts/main';
  </script>
</body>
</html>
